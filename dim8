#!/usr/bin/env python3
"""
dim8  --  dimension-eight SMEFT models for MadGraph, one process at a time.

    ./dim8 rebuild                     gen/operators.py to the released models: build, index, each UFO and its release
    ./dim8 build                       check the encoding, compute and cache the vertices (slow, once)
    ./dim8 index                       export the vertex field content for the selector
    ./dim8 select "p p > h j j"        which operators can contribute, and why
    ./dim8 select "p p > h j j" --card vbf   ... and write restrict_vbf.dat into the model
    ./dim8 model  "p p > h j j" -o vbf write the FeynRules model for just those
    ./dim8 ufo    "p p > h j j" -o vbf write the UFO for just those
    ./dim8 series "u u~ > w+ w-"       the amplitude topology by topology as a series in lambda
    ./dim8 check                       run the symbolic validation gates

The point of the process argument is that nobody should import every vertex of 674
operators to study one final state.  The selection is not a hand-maintained table: an
operator is kept exactly when one of its Feynman rules can sit in a tree diagram whose
external legs are the process, decided against the Standard Model's own vertices.  See
gen/process.py.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys

ROOT = os.path.dirname(os.path.abspath(__file__))
# vertex cache: DIM8_VDIR overrides build/vertices.  A cloud-synced folder can evict files when the
# disk fills, and an evicted file reads back empty, so keep the live cache on local storage.
VDIR = os.environ.get("DIM8_VDIR", os.path.join(ROOT, "build/vertices"))
sys.path.insert(0, os.path.join(ROOT, "gen"))
sys.path.insert(0, os.path.join(ROOT, "validate"))

# WS names wolframscript, and otherwise it is the one on the PATH or the macOS application
WOLFRAM = (os.environ.get("WS") or shutil.which("wolframscript")
           or "/Applications/Wolfram.app/Contents/MacOS/wolframscript")


def _need(path, hint):
    if not os.path.exists(path):
        sys.exit(f"missing {os.path.relpath(path, ROOT)}\n  -> {hint}")


# ---------------------------------------------------------------------------- build ----


# The six operators of Q_{G^4} with a dual field strength.  Their vertices with seven and eight gluons
# exceed 122 GB in FeynRules even one monomial at a time, so ./dim8 build has FeynRules compute these
# six, and no other operator, up to six legs.  It keeps their Levi-Civita tensors as written
# (DIM8_EPSEPS=0), the form in which six legs take minutes at 6 GB in chunks of 25 terms where the
# rewritten form takes hours.  Their status lines read "maxlegs 6".  validate/g4_highleg.py then writes the
# vertices with seven and eight gluons from the operators themselves, and their status lines read "highleg
# 7 8", or whichever of them are nonzero.  Resolved by coefficient name so the list cannot go stale.
CAPPED_WCS = ("c8G4x2", "c8G4x4", "c8G4x5", "c8G4x6", "c8G4x8", "c8G4x9")
CAP_ENV = {"DIM8_MAXLEGS": "6", "DIM8_EPSEPS": "0", "DIM8_CHUNK": "25"}
# The recursion limit of a worker.  FeynRules sets it to 2500 when it loads, and the large blocks exceed
# that, so a worker stops with TerminatedEvaluation[RecursionLimit] and the blocks after it stay missing.
WORKER_RECURSION = 20000


def _need_wolfram():
    if not (shutil.which(WOLFRAM) or os.path.exists(WOLFRAM)):
        sys.exit(f"wolframscript not found at {WOLFRAM}\n  -> set WS to it")
    _need(os.path.join(ROOT, "external", "feynrules", "feynrules-current"),
          "unpack FeynRules 2.3.49 there, where the Wolfram scripts of validate/ load it from")


def _wolfram_env(**extra):
    """The environment of a Wolfram script, which reads the tree named by DIM8_ROOT."""
    return dict(os.environ, DIM8_ROOT=ROOT, **extra)


def _numpy_python():
    """The Python that examples/release_model.sh runs its zero tests with: the first of DIM8_NUMPY_PY,
    python3.13 and python3 that imports numpy, or None."""
    for p in os.environ.get("DIM8_NUMPY_PY", "").split() + ["python3.13", "python3"]:
        if shutil.which(p) and subprocess.call([p, "-c", "import numpy"], stdout=subprocess.DEVNULL,
                                               stderr=subprocess.DEVNULL) == 0:
            return p
    return None


def _release_tools():
    """What examples/release_model.sh lacks here, as lines to print.  It runs after the hours of writing
    a UFO, which a second run repeats, so ./dim8 rebuild asks before it starts.  Without numpy the release
    stops, and without MadGraph it would release a model that no generator has imported."""
    out = []
    if _numpy_python() is None:
        out.append("no Python with numpy for the zero tests of the release\n"
                   "  -> install numpy, or set DIM8_NUMPY_PY to a Python that has it")
    if (os.environ.get("DIM8_SKIP_MG5_IMPORT") != "1"
            and not os.access(os.path.join(os.environ.get("MG5_DIR", ""), "bin", "mg5_aMC"), os.X_OK)):
        out.append("no MadGraph for the import test of the release\n"
                   "  -> set MG5_DIR, or DIM8_SKIP_MG5_IMPORT=1 to release without the test")
    return out


def _command_line(script, args, extra):
    """How a Wolfram script is run, as a line to print, with the variables set for it."""
    import shlex
    return " ".join([f"{k}={shlex.quote(v)}" for k, v in extra.items()]
                    + [shlex.quote(WOLFRAM), "-file", f"validate/{script}"] + [shlex.quote(str(x)) for x in args])


def _run_wolfram(script, args, env, log):
    """Run validate/<script> with its output in build/logs/<log>, and return its exit status.  A kernel
    that finds no licence seat is retried every two minutes for up to twelve hours."""
    import re
    import time
    path = os.path.join(ROOT, "build", "logs", log)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    for attempt in range(360):
        with open(path, "w") as fh:
            rc = subprocess.call([WOLFRAM, "-file", os.path.join(ROOT, "validate", script)] + [str(x) for x in args],
                                 stdout=fh, stderr=fh, env=env)
        if not re.search(r"not activated|license|password", open(path, errors="replace").read(), re.I):
            return rc
        print(f"build/logs/{log}: no licence seat, attempt {attempt + 1}", flush=True)
        time.sleep(120)
    return 1


def _load_encoding():
    """The operators of gen/operators.py.  An index that is not contracted raises when the operator is
    constructed, so a file that does not load stops here, with its line and the reason."""
    import traceback
    try:
        return _parse_all()
    except Exception as e:
        at = [f.lineno for f in traceback.extract_tb(e.__traceback__) if f.filename.endswith("operators.py")]
        sys.exit(f"gen/operators.py {f'line {at[-1]} ' if at else ''}does not load: {type(e).__name__}: {e}")


def _write_text(path, text):
    """Write a file through a temporary one, so that a failed write leaves the old file, and leave it
    alone when nothing changes."""
    if os.path.exists(path) and open(path, errors="replace").read() == text:
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w") as fh:
        fh.write(text)
    os.replace(path + ".tmp", path)


def _write_catalogue():
    """docs/catalogue.json, the table examples/cards/coefficients.md and the LaTeX rendering
    docs/catalogue_ops.tex, from the encoding.  The class summary that gen/catalogue_table.py writes
    beside them goes to build/."""
    import catalogue_json
    import catalogue_table
    catalogue_json.main(["catalogue_json"])
    catalogue_table.main(["catalogue_table", os.path.join(ROOT, "build")])


def _prepare_sources(dry_run=False, relations_updated=False):
    """What ./dim8 build does before any Mathematica.  Nothing is written until every check has passed:
    every operator must pass validate/structural.py, its recorded CP parity must be what its encoded
    terms give (gen/cp_parity.py), the block index written from the encoding must keep the block,
    the operator and the coefficient of every existing entry (index_mismatch in gen/emit_fr.py), and no
    operator of the input relations may change, unless relations_updated says that the base files have
    been written again for it.  Then the Lagrangian the workers load, the block index, the catalogue
    and the readable copies of models/src are written from the encoding, so that no operator can be
    built from a stale file.  With dry_run nothing is written, and the cache is compared with the
    Lagrangian that would be.  Returns the index and the blocks whose definition changes, each with the
    stamp of its old code."""
    import cache_source as CS
    import cp_parity
    import structural
    from emit_fr import emit_flavour_files, emit_model_fragment, index_mismatch

    if ";" in VDIR:
        sys.exit(f"DIM8_VDIR names several directories ({VDIR}), and the dimension-eight cache is one directory")
    ops = _load_encoding()
    if structural.report(ops):
        sys.exit("stopped: an operator of gen/operators.py fails validate/structural.py, see above. Nothing was written.")
    if cp_parity.report_disagreements(ops):
        sys.exit("stopped: the recorded CP parity (cp= in gen/operators.py) and the encoded terms disagree, see above.\n"
                 "That is a finding about the operator or the rule, and nothing overwrites either. Nothing was written.")
    txt, index = emit_model_fragment(ops, per_block=1)
    ipath = os.path.join(ROOT, "docs", "block_index.json")
    old = json.load(open(ipath)) if os.path.exists(ipath) else []
    bad = index_mismatch(index, old)
    if bad:
        sys.exit("stopped: gen/operators.py changes the block, the name or the coefficient of an existing operator,\n"
                 "or gives two operators one name or one coefficient. The vertex cache, the released models and the\n"
                 "restriction cards are keyed on them, so correct an operator in place and append a new one after the\n"
                 "last, with a name and a coefficient of its own. Nothing was written.\n  "
                 + "\n  ".join(bad[:20]) + ("\n  ..." if len(bad) > 20 else ""))
    gen = os.path.join(ROOT, "tests", "gen_smoke", "gen.fr")
    # A clone has no gen.fr before its first build, and the readable copy it ships holds the same text.
    readable = os.path.join(ROOT, "models", "src", "dim8_generated.fr")
    ref = gen if os.path.exists(gen) else readable
    changed = CS.changed_blocks(open(ref, errors="replace").read(), txt) if os.path.exists(ref) else {}
    # The input relations in the base files are derived from these operators by hand and are not written
    # from the encoding.  A model written on the old relation would be inconsistent, and only the G_F
    # closure and Ward tests that come after this chain would show it.
    relations = [e for e in index if e["block"] in changed and set(e["wcs"]) & set(INPUT_SCHEME_WCS)]
    if relations and not relations_updated:
        sys.exit("stopped: gen/operators.py changes operators that enter the input relations: "
                 + ", ".join(f"{e['ops'][0]} ({e['block']})" for e in relations) + ".\n"
                 "The base files hold those relations, which are not written from the encoding, so a model written now\n"
                 "would keep the old relation. Correct it in gen/derive_input_scheme.py, gen/derive_rotation.py or\n"
                 "gen/derive_higgs_yukawa.py, write the base files again with gen/input_scheme.py (models/src/README.md\n"
                 "gives the commands), and run this command again with --relations-updated. Nothing was written.")
    CS.use_gen_text(txt)
    print(f"encoding: {len(index)} operators, {max(len(index) - len(old), 0)} of them appended, "
          f"{len(changed)} with a changed definition in gen.fr" + (": " + " ".join(list(changed)[:30]) if changed else ""))
    if dry_run:
        return index, changed
    # A cached block without a stamp would be taken as current.  One whose definition is about to change
    # is not, so it gets the stamp of its old code, on which the worker rebuilds it.
    for b, stamp in changed.items():
        if CS.state(VDIR, b) == "unstamped":
            CS.write_stamp(VDIR, b, stamp)
    _write_text(gen, txt)
    # the general flavour coefficients the workers declare beside gen.fr, and the rules that put the
    # flavour structures in their place when a UFO is written (gen/emit_flavour.py)
    for name, text in emit_flavour_files(ops).items():
        _write_text(os.path.join(ROOT, "tests", "gen_smoke", name), text)
    _write_text(ipath, json.dumps(index, indent=1))
    if os.path.exists(readable):
        _write_text(readable, txt)
    for b in ("base.fr", "base_fg.fr", "base_inputscheme.fr", "base_inputscheme_mw.fr"):
        base, copy = os.path.join(ROOT, "tests", "gen_smoke", b), os.path.join(ROOT, "models", "src", b)
        if os.path.exists(base) and os.path.exists(copy):
            _write_text(copy, open(base, errors="replace").read())
    _write_catalogue()
    return index, changed


def _capped_blocks(index):
    by_wc = {w: e["block"] for e in index for w in e["wcs"]}
    missing = [w for w in CAPPED_WCS if w not in by_wc]
    if missing:
        sys.exit(f"coefficients of the capped operators not in the encoding: {missing}")
    return {by_wc[w] for w in CAPPED_WCS}


def _worker_plan(pending, capped, jobs):
    """(log tag, blocks, variables) of each worker: the capped blocks in a worker of their own, since
    the variables act on every block of a worker, and the others shared out over the remaining jobs."""
    cap = [b for b in pending if b in capped]
    rest = [b for b in pending if b not in capped]
    plan = [("capped", cap, dict(CAP_ENV))] if cap else []
    n = max(jobs - len(plan), 1)
    return plan + [(str(s + 1), rest[s::n], {}) for s in range(n) if rest[s::n]]


def _without_highleg(blocks):
    """The capped blocks in the cache that FeynRules has finished and validate/g4_highleg.wls has not."""
    out = []
    for b in sorted(blocks):
        st = os.path.join(VDIR, b + ".status")
        if os.path.exists(st) and "highleg" not in open(st, errors="replace").read():
            out.append(b)
    return out


def _complete_capped(index, env):
    """Add the vertices with seven and eight gluons to the capped blocks that lack them, or return 1."""
    todo = _without_highleg(_capped_blocks(index))
    if not todo:
        return 0
    by_block = {e["block"]: w for e in index for w in e["wcs"]}
    print(f"  seven and eight gluons: {len(todo)} blocks, log in build/logs/highleg.log", flush=True)
    return _run_wolfram("g4_highleg.wls", ["merge", VDIR, VDIR.rstrip("/") + "_highleg"]
                        + [f"{b}={by_block[b]}" for b in todo], env, "highleg.log")


def _build_vertices(a, index, changed, only=None):
    """Run the workers over the blocks that are missing or built from a different source, so that one
    edited operator starts one worker.  The worker decides the same way when it is run alone.  only
    names the blocks of a trial of ./dim8 rebuild, which leaves every other block as it is.  Returns the
    exit status, 1 when blocks are still missing or stale afterwards."""
    import cache_source as CS
    from concurrent.futures import ThreadPoolExecutor

    blocks = [e["block"] for e in index if only is None or e["block"] in only]
    states = {b: CS.state(VDIR, b) for b in blocks}
    pending = [b for b in blocks if states[b] in ("missing", "stale") or (states[b] == "unstamped" and b in changed)]
    stale = [b for b in pending if states[b] != "missing"]
    unstamped = [b for b in blocks if states[b] == "unstamped" and b not in changed]
    plan = _worker_plan(pending, _capped_blocks(index), a.jobs)
    print(f"vertices: {len(pending)} of {len(blocks)} blocks to compute in {VDIR}, "
          f"{len(stale)} of them stale" + (": " + " ".join(stale[:30]) if stale else ""))
    if unstamped:
        print(f"  {len(unstamped)} cached blocks carry no stamp and are taken as current, "
              f"python3 validate/cache_source.py backstamp {VDIR} checks them")
    if a.dry_run:
        for tag, part, extra in plan:
            print(f"  worker {tag}: " + _command_line("fr_worker.wls", [",".join(part), 0, len(index), a.kernels, WORKER_RECURSION], extra))
        cap = _capped_blocks(index) & set(blocks)
        todo = sorted(set(_without_highleg(cap)) | (cap & set(pending)))
        if todo:
            print("  then seven and eight gluons, validate/g4_highleg.wls merge: " + " ".join(todo))
        return 0
    if plan:
        _need_wolfram()
        os.makedirs(VDIR, exist_ok=True)
        env = _wolfram_env(DIM8_VDIR=VDIR)
        for k in ("DIM8_MAXLEGS", "DIM8_MINLEGS", "DIM8_EPSEPS"):     # the plan sets these, block by block
            env.pop(k, None)
        for tag, part, extra in plan:
            print(f"  worker {tag}: {len(part)} blocks, log in build/logs/worker_{tag}.log", flush=True)
        print(f"  progress:  ls {VDIR}/*.status | wc -l", flush=True)

        def run(spec):
            tag, part, extra = spec
            return _run_wolfram("fr_worker.wls", [",".join(part), 0, len(index), a.kernels, WORKER_RECURSION],
                                dict(env, **extra), f"worker_{tag}.log")

        with ThreadPoolExecutor(max_workers=max(a.jobs, 1)) as pool:
            list(pool.map(run, plan))
    if only is None and _without_highleg(_capped_blocks(index)):
        _need_wolfram()
        env = _wolfram_env(DIM8_VDIR=VDIR)
        if _complete_capped(index, env):
            print("the vertices with seven and eight gluons were not added, see build/logs/highleg.log")
            return 1
    if os.path.isdir(VDIR):
        cmd_status(a)
    left = [b for b in blocks if CS.state(VDIR, b) in ("missing", "stale")]
    if only is None:
        left += _without_highleg(_capped_blocks(index))
    if left:
        print(f"{len(left)} blocks are still missing or stale, see build/logs/worker_*.log: " + " ".join(left[:30])
              + ("\nRun the same command again, since blocks already computed are skipped." if plan else ""))
        return 1
    return 0


def cmd_build(a):
    """Check the encoding, write the files made from it, and fan the blocks that need it out over N
    external FeynRules processes, which cache each one."""
    index, changed = _prepare_sources(a.dry_run, a.relations_updated)
    if a.source_only:
        return 0
    return _build_vertices(a, index, changed)


# -------------------------------------------------------------------------- rebuild ----


# The models ./dim8 rebuild writes: the name, the input scheme of the base it is written on (SCHEME_BASE)
# and whether it carries the dimension-six sector.  Every one with an input scheme is written with the
# truncation of validate/np_truncate.m.  dim8_plain has neither and ships only as a control, so it is rebuilt
# where it exists, since validate/index_vs_ufo.py compares the vertex list with it.
REBUILD_MODELS = (("dim8_mw", "mw", False), ("dim8_is", "alpha", False), ("dim68_mw", "mw", True),
                  ("dim68_is", "alpha", True), ("dim8_plain", None, False))
# set per step by ./dim8 rebuild, so that one left in the shell cannot change a released model
REBUILD_SETS = ("DIM8_BASE", "DIM8_TRUNCATE", "DIM8_LSM", "DIM8_NPORDER", "DIM8_DRYRUN", "DIM8_MAXLEGS", "DIM8_MINLEGS",
                "DIM8_EPSEPS", "DIM8_INDEX_TAG", "DIM8_INDEX_MERGE", "DIM8_HERM", "DIM8_HERMONLY")
# ./dim8 rebuild writes the vertex lists under this tag, and they replace the lists that ./dim8 select
# reads only when validate/index_vs_ufo.py has compared them with the released models and removed what
# no model has.  A chain that fails on the way, hours later, leaves the lists as they were.
NEW_LISTS = "_new"
VERTEX_LISTS = ("vertex_index", "sm_vertices", "lsm_vertices")


def _v6dir(scheme):
    """The dimension-six cache of a scheme, a directory of its own so that a plain dimension-eight build
    cannot pick it up by accident (docs/DIM6.md): DIM8_VDIR6, or DIM8_VDIR6_MW for the {MW, MZ, GF}
    scheme, and otherwise beside the dimension-eight cache, with the suffix 6 or 6_mw."""
    if scheme == "mw":
        return os.environ.get("DIM8_VDIR6_MW", VDIR.rstrip("/") + "6_mw")
    return os.environ.get("DIM8_VDIR6", VDIR.rstrip("/") + "6")


def _dim6_file():
    return os.path.join(ROOT, "tests", "gen_smoke", "dim6_smeftsim.fr")


def _dim6_blocks():
    """The dimension-six classes, as tests/gen_smoke/dim6_smeftsim.fr lists them."""
    import re
    m = re.search(r"DIM6\$Classes = \{([^}]*)\}", open(_dim6_file()).read())
    if not m:
        sys.exit("tests/gen_smoke/dim6_smeftsim.fr has no list DIM6$Classes: run gen/make_dim6.py again")
    return re.findall(r'"(\w+)"', m.group(1))


def _rebuilt_models(asked):
    """The entries of REBUILD_MODELS to write.  Without a list these are all that this tree can write:
    a combined model needs tests/gen_smoke/dim6_smeftsim.fr, which gen/make_dim6.py writes from the
    FeynRules sources of SMEFTsim, which are not redistributed."""
    have6 = os.path.exists(_dim6_file())
    if asked:
        out = [m for m in REBUILD_MODELS if m[0] in asked]
        if any(m[2] for m in out) and not have6:
            sys.exit("no tests/gen_smoke/dim6_smeftsim.fr for the combined models\n"
                     "  -> obtain SMEFTsim's FeynRules sources from its authors and run gen/make_dim6.py (docs/DIM6.md)")
        return out
    out = [m for m in REBUILD_MODELS if (have6 or not m[2]) and (m[0] != "dim8_plain" or os.path.isdir(os.path.join(ROOT, "models", m[0])))]
    if not have6:
        print("the combined models are left out: they need tests/gen_smoke/dim6_smeftsim.fr, "
              "which gen/make_dim6.py writes from the FeynRules sources of SMEFTsim (docs/DIM6.md)")
    return out


def _refuse_unstamped(a, vdir, blocks, bases=None):
    """./dim8 rebuild takes no block without a stamp.  The stamp is what shows that a correction has
    reached a block, and without it the worker skips the block and the writer lets it through, so a
    model would be released from the old vertices with only a notice.  A dry run says so and goes on."""
    import cache_source as CS
    bare = [b for b in blocks if CS.state(vdir, b, bases=bases) == "unstamped"]
    if not bare:
        return
    how = (f"python3 validate/cache_source.py backstamp {vdir} --write stamps those that agree with the history "
           "of gen.fr and marks the others for a rebuild" if bare[0].startswith("L8op")
           else "delete them, and they are computed again")
    msg = (f"{len(bare)} cached blocks in {vdir} carry no stamp, so nothing shows which source they were built from: "
           + " ".join(bare[:30]) + (" ..." if len(bare) > 30 else "") + f"\n  -> {how}")
    if not a.dry_run:
        sys.exit("stopped: " + msg)
    print("a run would stop here: " + msg)


def _build_dim6(a, scheme, only=None):
    """The workers' step for the dimension-six blocks of a scheme, computed on its base, in its cache.
    only names the blocks of a trial of ./dim8 rebuild."""
    import cache_source as CS
    base, v6 = SCHEME_BASE[scheme], _v6dir(scheme)
    blocks = [b for b in _dim6_blocks() if only is None or b in only]
    _refuse_unstamped(a, v6, blocks, bases=[base])
    pending = [b for b in blocks if CS.state(v6, b, bases=[base]) in ("missing", "stale")]
    extra = {"DIM8_BASE": f"{base};dim6_smeftsim.fr", "DIM8_VDIR": v6}
    args = [",".join(pending), 0, len(blocks), a.kernels, WORKER_RECURSION]
    print(f"dimension-six vertices on {base}: {len(pending)} of {len(blocks)} blocks to compute in {v6}")
    if not pending:
        return
    if a.dry_run:
        print("  " + _command_line("fr_worker.wls", args, extra))
        return
    os.makedirs(v6, exist_ok=True)
    _run_wolfram("fr_worker.wls", args, _wolfram_env(**extra), f"worker6_{scheme}.log")
    left = [b for b in blocks if CS.state(v6, b, bases=[base]) in ("missing", "stale")]
    if left:
        sys.exit(f"stopped: dimension-six blocks still missing or stale, see build/logs/worker6_{scheme}.log: {' '.join(left)}")


def _shown(argv):
    """A step of the chain as a line to print, with the paths in this tree relative to it."""
    return "  " + " ".join(os.path.relpath(x, ROOT) if x.startswith(ROOT + os.sep) else x for x in argv)


def _run_step(argv):
    """Run a step of the chain that needs no Mathematica, and stop if it fails."""
    print(_shown(argv), flush=True)
    rc = subprocess.call(argv, cwd=ROOT)
    if rc:
        sys.exit(f"stopped: this step exited with status {rc}, and the steps after it have not run")


def _release_blocks(index, with6, b=None):
    """The blocks of a released model: every operator of the basis (gen/basis.py: DIM8_BASIS, or b) that
    conserves baryon number, whatever its place in the encoding, and the dimension-six classes for a
    combined model."""
    import basis
    import cp_parity
    bviol = cp_parity.baryon_violating()
    return ([e["block"] for e in index if not bviol & set(e["ops"]) and basis.in_basis(e["wcs"], b)]
            + (_dim6_blocks() if with6 else []))


def _write_and_release(a, index, name, scheme, with6):
    """One model: its block list, the UFO on the base of its scheme and examples/release_model.sh, which
    audits the model before it replaces the old one.  A trial (--blocks) goes to models/<name>_trial, so
    that the model it replaces is not touched.  Returns the name of the released model."""
    base = SCHEME_BASE[scheme] if scheme else "base.fr"
    raw, release = name + "_raw", name + "_trial" if a.blocks else name
    extra = {"DIM8_BASE": f"{base};dim6_smeftsim.fr" if with6 else base,
             "DIM8_VDIR": f"{VDIR};{_v6dir(scheme)}" if with6 else VDIR}
    if scheme:
        extra["DIM8_TRUNCATE"] = "1"
    sel = os.path.abspath(a.blocks) if a.blocks else os.path.join(ROOT, "build", name + ".blocks")
    rawdir = os.path.join(ROOT, "tests", "gen_smoke", raw)
    step = ["bash", os.path.join(ROOT, "examples", "release_model.sh"), rawdir, release]
    print(f"model {release}: on {extra['DIM8_BASE']}", flush=True)
    # in shards, hpc/write_shards.sh writes the blocks in that many small UFOs side by side and joins them
    # (validate/merge_ufo.py).  The base model's vertices are a shard of their own, written with the operators
    # that enter its relations, whose vacuum pieces cancel against the shifts the base carries only when the
    # two are merged and truncated together (hpc/write_shards.sh)
    shard = os.path.join(ROOT, "hpc", "write_shards.sh")
    withbase = os.path.join(ROOT, "build", name + ".withbase")
    plan = [["plan", raw[:-4], sel, str(a.shards + 1), withbase], ["run", raw[:-4], "0", str(a.shards), str(a.par)],
            ["merge", raw[:-4]]]
    if a.dry_run:
        if a.shards:
            for s in plan:
                print("  " + _shown(["bash", shard] + s))
        else:
            print("  " + _command_line("fr_writeufo.wls", [raw, os.path.relpath(sel, ROOT)], extra))
        print(_shown(step))
        return release
    if not a.blocks:
        _write_text(sel, "\n".join(_release_blocks(index, with6)) + "\n")
    shutil.rmtree(rawdir, ignore_errors=True)
    if a.shards:
        _write_text(withbase, "".join(b + "\n" for b in sorted((_input_scheme_blocks() if scheme else set())
                                                                 | (set(_dim6_blocks()) if with6 else set()), key=_bkey)))
        # write_shards.sh skips a shard that is already written, which is for a run cut short by hand; the shards
        # of an earlier rebuild hold blocks that may have changed since, so they go
        import glob
        for d in glob.glob(os.path.join(ROOT, "tests", "gen_smoke", raw[:-4] + "_s[0-9]*_raw")):
            shutil.rmtree(d)
        for f in glob.glob(os.path.join(ROOT, "logs", "shards", raw[:-4] + "[_.]*")):
            os.remove(f)
        print(f"  writing the UFO in {a.shards} shards and the base, {a.par} at a time, logs in logs/shards", flush=True)
        env = _wolfram_env(**extra, WS=WOLFRAM, DIM8_NUMPY_PY=_numpy_python() or "python3")
        for s in plan:
            rc = subprocess.call(["bash", shard] + s, cwd=ROOT, env=env)
            if rc:
                sys.exit(f"stopped: hpc/write_shards.sh {s[0]} for {name} exited with status {rc}, see logs/shards/{raw[:-4]}_*.log")
    else:
        log = f"write_{name}.log"
        print(f"  writing the UFO, which takes hours, log in build/logs/{log}", flush=True)
        # the exit status and not the last line of the log, which a kernel can lose as it exits (it did on half of
        # the writers of a cluster job, whose models then passed the audits of the release)
        rc = _run_wolfram("fr_writeufo.wls", [raw, sel], _wolfram_env(**extra), log)
        if rc:
            sys.exit(f"stopped: the writer did not finish {name}, see build/logs/{log}")
    if not os.path.exists(os.path.join(rawdir, "vertices.py")):
        sys.exit(f"stopped: no UFO was written for {name} in {os.path.relpath(rawdir, ROOT)}")
    _run_step(step)
    return release


def cmd_rebuild(a):
    """From gen/operators.py to the released models.  See the help of the command, and models/src/README.md."""
    for k in REBUILD_SETS:
        if os.environ.pop(k, None) is not None:
            print(f"{k} in the environment is ignored, this command sets it for each step")
    import basis
    # in the Murphy basis (DIM8_BASIS=murphy) each model is released under its name with the suffix _murphy
