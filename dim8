              + ".  The released models and the vertex lists of the selector were left alone.")
        return 0
    print("after the models:", flush=True)
    py = [sys.executable]
    with6 = [os.path.join(ROOT, "models", m[0]) for m in models if m[2]]
    steps = [py + [os.path.join(ROOT, "gen", "catalogue_json.py")],
             py + [os.path.join(ROOT, "gen", "catalogue_table.py"), os.path.join(ROOT, "build")]]
    if with6:
        steps.append(py + [os.path.join(ROOT, "validate", "dim6_index.py"), "--models"] + with6)
    final = py + [os.path.join(ROOT, "validate", "index_vs_ufo.py"), "--write", "--index",
                  os.path.join(ROOT, "build", f"vertex_index{NEW_LISTS}.json")]
    template = os.path.join(ROOT, "models", "dim8_is", "param_card_template.dat")
    if a.dry_run:
        for s in steps + [final]:
            print(_shown(s))
        print("a dry run: nothing was run or written")
        return 0
    for s in steps:
        _run_step(s)
    # release_model.sh leaves the card of the last model in examples/cards, and the example is that of dim8_is,
    # the model the scripts of examples/mg5 import, whose block SMINPUTS it fits
    if os.path.exists(template):
        shutil.copy(template, os.path.join(ROOT, "examples", "cards", "param_card_template.dat"))
    print(_shown(final), flush=True)
    rc = subprocess.call(final, cwd=ROOT)
    others = [m[0] for m in REBUILD_MODELS if m[0] not in [x[0] for x in models]
              and os.path.isfile(os.path.join(ROOT, "models", m[0], "parameters.py"))]
    if rc:
        print("validate/index_vs_ufo.py found an error, so the vertex lists that ./dim8 select reads were not replaced, and "
              f"the new ones wait in build/vertex_index{NEW_LISTS}.json"
              + (f".  These models were not rewritten and are compared as they are: {', '.join(others)}" if others else ""))
        return rc
    for f in VERTEX_LISTS:
        new = os.path.join(ROOT, "build", f + NEW_LISTS + ".json")
        if os.path.exists(new):
            os.replace(new, os.path.join(ROOT, "build", f + ".json"))
    print("released: " + " ".join(released) + ".  The tests of docs/HOW_TO_BREAK_IT.md come next.  "
          "This command does not rewrite the Feynman-gauge lists in build/ or build/onshell_zero.json (models/src/README.md)."
          + ("  MadGraph has not imported these models, since DIM8_SKIP_MG5_IMPORT=1." if os.environ.get("DIM8_SKIP_MG5_IMPORT") == "1" else ""))
    return 0


def cmd_status(a):
    vd = VDIR
    if not os.path.isdir(vd):
        sys.exit("nothing built yet, run ./dim8 build")
    # errors="replace": a status file written by a Wolfram kernel on another platform can
    # carry a non-UTF-8 byte, and one such file must not take the whole status report down
    st = [open(os.path.join(vd, f), errors="replace").read().strip() for f in sorted(os.listdir(vd)) if f.endswith(".status") and not f.startswith(".")]
    total = len(json.load(open(os.path.join(ROOT, "docs/block_index.json"))))
    # "nonhermitian -1" means the check was DEFERRED (built with DIM8_HERM=0), not that it
    # passed.  Count those separately so a deferred block can never be mistaken for a clean
    # one; DIM8_HERMONLY=1 runs the outstanding checks.  "nonhermitian hc" is a block written as
    # X + HC[X] throughout, Hermitian by construction, which needs no check.
    deferred = [s for s in st if "nonhermitian -1" in s]
    bad = [s for s in st if "nonhermitian 0 " not in s and "nonhermitian hc" not in s
           and "nonhermitian -1" not in s and "SKIPPED" not in s]
    ok = len(st) - len(bad) - len(deferred)
    print(f"cached {len(st)}/{total} blocks")
    print(f"hermiticity: {ok} pass, {len(bad)} FAIL, {len(deferred)} not checked")
    for s in bad:
        print("  " + s)
    if deferred:
        print(f"  {len(deferred)} blocks built with the check deferred; run with DIM8_HERMONLY=1 to complete them")
    # FeynRules prints QN::NonConserv when a vertex violates a conserved quantum number.
    # It is a free correctness gate: attribute each warning to the block that finished
    # after it in the worker log.
    import glob
    import re

    warn = {}
    for f in glob.glob(os.path.join(ROOT, "build/logs/worker_*_num.log")):
        pending = 0
        for line in open(f, errors="replace"):
            # only electric charge: the B-violating blocks (675-734) violate FeynRules'
            # baryon and lepton numbers by construction, so those warnings carry no information
            if "Quantum number Q not conserved" in line:
                pending += 1
            m = re.search(r"\[done\] (L8op\d+)", line)
            if m and pending:
                warn[m.group(1)] = warn.get(m.group(1), 0) + pending
                pending = 0
    print(f"charge/quantum-number warnings: {len(warn)} blocks")
    for b, n in sorted(warn.items(), key=lambda kv: int(kv[0][4:])):
        print(f"  {b}: {n} QN::NonConserv")


def _index_dirs():
    """The caches the vertex lists of the selector are read from: DIM8_VDIR as it is when it names
    several, and otherwise the dimension-eight cache with, where it exists, the dimension-six cache of
    the {alpha, MZ, GF} scheme, since the lists hold the dimension-six classes too and
    validate/index_vs_ufo.py compares those with dim68_is."""
    dirs = [d.strip() for d in VDIR.split(";") if d.strip()]
    if len(dirs) == 1 and os.path.isdir(_v6dir("alpha")) and os.path.exists(_dim6_file()):
        dirs.append(_v6dir("alpha"))
    return dirs


def _dump_index(dry_run=False, tag=""):
    """validate/dump_vertex_index.wls on those caches, which stops on a stale block as the writer does,
    since the selector would otherwise list the vertices of an operator that has changed.  Where no cache
    holds the dimension-six classes, which need SMEFTsim's sources, the lists keep what they hold of them,
    which a correction to a dimension-eight operator does not change.  A tag goes into the names of the
    files written, and the lists the selector reads stay as they are."""
    import cache_source as CS
    dirs = _index_dirs()
    extra = {"DIM8_VDIR": ";".join(dirs)}
    if tag:
        extra["DIM8_INDEX_TAG"] = tag
    if dry_run:
        print("  " + _command_line("dump_vertex_index.wls", [], extra))
        return
    for d in dirs:
        _need(d, "./dim8 build")
    if CS.check(dirs):
        sys.exit("stopped: stale blocks in the caches, and ./dim8 build recomputes a dimension-eight block and ./dim8 rebuild "
                 "a dimension-six one. The vertex lists were not written.")
    _need_wolfram()
    vpath, spath = (os.path.join(ROOT, "build", f) for f in ("vertex_index.json", "sm_vertices.json"))
    keep = None
    if os.path.exists(vpath) and os.path.exists(spath) and not any(f.startswith("L6cl") for d in dirs for f in os.listdir(d)):
        keep = ({b: v for b, v in json.load(open(vpath)).items() if b.startswith("L6")}, open(spath).read())
    rc = _run_wolfram("dump_vertex_index.wls", [], _wolfram_env(**extra), "index.log")
    text = open(os.path.join(ROOT, "build", "logs", "index.log"), errors="replace").read()
    for line in text.splitlines():
        if line.startswith("["):
            print("  " + line)
    if rc:
        sys.exit("stopped: the index dump failed, see build/logs/index.log")
    if keep and keep[0]:
        print(f"  no cache holds the dimension-six classes here, so the lists keep their {len(keep[0])} blocks")
        vnew, snew = (os.path.join(ROOT, "build", f + tag + ".json") for f in ("vertex_index", "sm_vertices"))
        _write_text(vnew, json.dumps(dict(json.load(open(vnew)), **keep[0])))
        _write_text(snew, keep[1])


def cmd_index(a):
    _dump_index()


