def _model_inputs(model):
    """External parameter -> LHA block of a UFO, read from its parameters.py."""
    import re
    out = {}
    path = os.path.join(model, "parameters.py")
    if not os.path.isfile(path):
        return out
    for b in re.split(r"\n(?=\w+ = Parameter\()", open(path, errors="replace").read()):
        m = re.match(r"\w+ = Parameter\(name = '(\w+)',\s*nature = 'external'", b)
        blk = re.search(r"lhablock = '(\w+)'", b)
        if m and blk:
            out[m.group(1)] = blk.group(1)
    return out


def _model_dir(arg):
    """The UFO directory --model names: a path, or the bare name of a model in models/.  Anything
    else stops, since a directory without parameters.py reads as a model with no input relations and
    the second group would silently disappear."""
    for d in (os.path.abspath(arg), os.path.join(ROOT, "models", arg)):
        if os.path.isfile(os.path.join(d, "parameters.py")):
            return d
    _unpacked(os.path.basename(os.path.normpath(arg)))
    sys.exit(f"{arg} is neither a UFO directory (no parameters.py) nor a model in models/")


def _unpacked(name):
    """Stop with the command that unpacks models/<name> when the release ships it packed and it has
    not been unpacked yet (README, Install)."""
    d = os.path.join(ROOT, "models")
    if not os.path.isdir(os.path.join(d, name)) and os.path.isfile(os.path.join(d, name + ".tar.xz")):
        sys.exit(f"models/{name} ships packed, unpack it first:\n    cd {d} && tar -xJf {name}.tar.xz")


def _scheme(model, inputs):
    """'mw' when M_W is an input, 'alpha' when the model carries the corrected input relations without
    it, and 'plain' otherwise.  The relations show in the internal parameter vev1, the first-order shift
    of the vev, which gen/input_scheme.py writes in both schemes and the plain base does not have.  The
    parameters look alike otherwise, since dim8_plain and dim8_is both take M_W from alpha, M_Z and G_F."""
    import re
    if inputs.get("MW") == "SMINPUTS":
        return "mw"
    params = open(os.path.join(model, "parameters.py"), errors="replace").read()
    return "alpha" if re.search(r"^vev1 = Parameter\(", params, re.M) else "plain"


def _reference_model(model, scheme):
    """The released model whose vertices the selection reads for the model directory `model`: itself when
    it is one of RELEASED, and otherwise the released model of its scheme in its basis (gen/basis.py),
    since a released model holds the class-11 operators of one basis only."""
    import basis
    name = os.path.basename(os.path.normpath(model))
    return name if name in RELEASED else basis.model_name(SCHEME_MODEL[scheme], basis.of_model(model))


def _for_model(vi, model):
    """The vertex index as the released model `model` has it.  build/vertex_index.json follows the
    input-scheme models.  build/vertex_index_absorbed.json, written by validate/index_vs_ufo.py
    --write, lists the vertices that an input scheme absorbs, with the models that carry them: the
    three-gluon vertex of Q_{G^2H^4}^{(1)} and the gauge vertices of Q_{W^2H^4}^{(1)}, which only
    dim8_plain has, and the W-lepton vertex of Q_{l^2H^4D}^{(2,4)}, which dim8_mw lacks."""
    path = os.path.join(ROOT, "build", "vertex_index_absorbed.json")
    if not os.path.exists(path):
        return vi
    data = json.load(open(path))
    if model not in data["models"]:
        return vi
    vi = {b: list(v) for b, v in vi.items()}
    for e in data["absorbed"]:
        legs = sorted(e["fields"])
        kept = [v for v in vi.get(e["block"], []) if sorted(v) != legs]
        if model in e["carried_by"]:
            kept.append(list(e["fields"]))
        if e["block"] in vi or kept:
            vi[e["block"]] = kept
    return vi


def _dim6_name(n):
    """The dimension-six coefficient an external parameter belongs to: cuH for cuHAbs and cuHPh, since a
    complex coefficient is set through its modulus and its phase."""
    import re
    return re.sub(r"(Abs|Ph|Re|Im)$", "", n)


def _dim6_index(model, scheme):
    """(coefficient -> {"one": [...], "rescaled": [...], "two": [...]}, the model it was read for) from
    build/dim6_index.json, for a model with a dimension-six sector of its own, or (None, why not).  The
    entry is the model's own when the index names it, and otherwise that of the released model with a
    dimension-six sector of its scheme (SCHEME_MODEL6).  An entry is not used when the file cannot be
    read (a truncated file, or one that a full disk has evicted), when it names a coefficient that
    gen/lambda_routes.py does not know, since its class and its power could not be given, and
    validate/dim6_index.py refuses to write one, or when it lacks a coefficient of the model, which the
    listing would miss and the card would zero (an entry left from an older model)."""
    import lambda_routes as LR

    path = os.path.join(ROOT, "build", "dim6_index.json")
    if not os.path.exists(path):
        return None, "build/dim6_index.json is not in this tree"
    try:
        data = json.load(open(path))["models"]
        name = os.path.basename(os.path.normpath(model))
        ref6 = name if name in data else SCHEME_MODEL6.get(scheme)
        entry = data[ref6] if ref6 in data else None
    except (OSError, ValueError, KeyError, TypeError, AttributeError) as e:
        return None, f"build/dim6_index.json cannot be read ({e.__class__.__name__})"
    if not isinstance(entry, dict):
        return None, f"build/dim6_index.json has no entry for {ref6 or name}"
    unknown = sorted(c for c in entry if c not in LR.DIM6_COEFF)
    if unknown:
        return None, (f"the entry of build/dim6_index.json for {ref6} names coefficients that gen/lambda_routes.py "
                      f"does not know ({', '.join(unknown[:4])})")
    lack = sorted({_dim6_name(k) for k, blk in _model_inputs(model).items() if blk == "DIM6"}
                  - set(entry))
    if lack:
        return None, (f"the entry of build/dim6_index.json for {ref6} lacks coefficients of this model "
                      f"({', '.join(lack[:4])}{', ...' if len(lack) > 4 else ''})")
    return entry, ref6


def _as_listed(legs, verts):
    """The legs of a dimension-six vertex, which build/dim6_index.json sorts, in the order in which
    build/vertex_index.json lists the same field content in the coefficient's class, so that a
    coefficient reads as the dimension-eight operators do, and sorted where the class lacks it."""
    key = sorted(legs)
    return next((list(v) for v in verts if sorted(v) == key), list(legs))


def _input_scheme_blocks(wcs=INPUT_SCHEME_WCS):
    idx = json.load(open(os.path.join(ROOT, "docs/block_index.json")))
    by_wc = {w: b["block"] for b in idx for w in b["wcs"]}
    missing = [w for w in wcs if w not in by_wc]
    if missing:
        sys.exit(f"input-scheme coefficients not in the catalogue: {missing}")
    return {by_wc[w] for w in wcs}


def _select(proc, collapse=True, with_bviol=False, two_insertions=False, model="dim8_mw", second=None,
            directory=None):
    """Operators the process can see, with the vertices of the released model `model` (one of
    RELEASED), read for the model directory `directory` (_model_vertices).  The B-violating classes
    18-21 are dropped unless
    asked for: their four-fermion vertices violate fermion flow, and MadGraph's ALOHA
    refuses helicity routines for 4-point flow-violating interactions (for u u > e+ d~ from
    Q_{eu^2dH^2} the diagrams are generated and the check stops with ALOHAERROR).  They are
    still generated, cached and Hermitian, for tools that can use them.  With two_insertions, a
    set passed as second receives the blocks that only the second pass of process.select finds."""
    import process as P

    vi, sm = _model_vertices(model, with_bviol=with_bviol, directory=directory)
    return P.select(proc, vi, sm, collapse=collapse, two_insertions=two_insertions, second=second), vi


def _model_vertices(model, gauge="unitary", with_bviol=False, directory=None):
    """The vertex lists of the released model `model` (one of RELEASED) and the vertices of its base,
    as ./dim8 select and ./dim8 series read them for the model directory `directory`, models/<model>
    unless another is given: build/vertex_index.json, and in Feynman gauge its Goldstone vertices from
    build/vertex_index_fg.json (process.load_data), with the vertices of the model's input scheme
    (_for_model), the class-11 operators of the model's basis alone, the B-violating classes only when
    asked for, no operator without a vertex in the model, and, for a model with a dimension-six sector
    of its own, the vertices of the dimension-six classes that the model has (_live_dim6).  The lists
    are checked against the couplings of the directory first (_check_vertices), and a mismatch stops
    the command."""
    import process as P

    import basis
    vi, sm = P.load_data(ROOT, gauge=gauge)
    vi = _for_model(vi, model)
    idx = {b["block"]: b for b in json.load(open(os.path.join(ROOT, "docs/block_index.json")))}
    # a released model holds the class-11 operators of one basis, and its name says which (gen/basis.py)
    b = "murphy" if model.endswith("_murphy") else "geo"
    own = os.path.join(ROOT, "models", model)
    directory = directory or own
    used = _coefficients(directory)
    if used is not None:
        _check_vertices(vi, idx, directory, b, used)
    vi = {k: v for k, v in vi.items() if k not in idx or basis.in_basis(idx[k]["wcs"], b)}
    if not with_bviol:
        vi = {k: v for k, v in vi.items() if idx.get(k, {}).get("cls", 0) < 18 or not _is_bviol(idx[k])}
    # An operator whose every vertex vanishes carries no vertex in the released models, since the
    # release step removes it (validate/drop_zero_structures.py), although FeynRules' vertex lists
    # still name it.  The four-fermion field-strength operators with two identical currents vanish with
    # their own coefficient, and all but Q_{e^4B}^{(2)} have vertices through a flavour structure on one
    # current.  A block left without a vertex is dropped here, so that the selection and the released
    # model agree.
    dead = _operators_without_vertex(idx, model, used if os.path.realpath(directory) == os.path.realpath(own) else None)
    vi = {k: v for k, v in vi.items() if k not in dead}
    if used is not None:
        vi = _live_dim6(vi, directory)
    return vi, sm


def _live_dim6(vi, directory):
    """The vertex lists vi with each dimension-six class cut to the vertices that the model directory
    `directory` has.  build/vertex_index.json gives FeynRules' vertices of a whole class, before the
    fields are normalised and the input relations imposed, and some of them are no vertex of the
    model: the four-boson vertices of C_HW, which the normalisation of the W field cancels, and in the
    {MW, MZ, GF} scheme the W-lepton vertex of C_Hl^(3), which G_F fixes.  A vertex without a Goldstone
    boson stays when build/dim6_index.json lists its field content under "one" for a coefficient of its
    class (validate/dim6_index.py): the content of an NP=1 coupling that the coefficient moves and
    that does not cancel over the vertex objects, which for the four coefficients of the input
    relations is a coupling that names them.  The index lists no Goldstone bosons, so a vertex with
    one stays.  A model without a dimension-six sector of its own, or without an entry in the index
    (_dim6_index), keeps the lists as they are."""
    import lambda_routes as LR

    inputs = _model_inputs(directory)
    if not any(blk == "DIM6" and k not in DIM6_IN_BASE for k, blk in inputs.items()):
        return vi
    entry, _ = _dim6_index(directory, _scheme(directory, inputs))
    if entry is None:
        return vi
    live = {}
    for c, e in entry.items():
        live.setdefault(LR.DIM6_COEFF[c][1], set()).update(tuple(sorted(v)) for v in e.get("one", []))
    gold = set(LR.GOLDSTONE.values())
    return {b: [v for v in vs if gold & set(v) or tuple(sorted(v)) in live.get(b, ())] if b in LR.DIM6 else vs
            for b, vs in vi.items()}


def _operators_without_vertex(idx, model="dim8_mw", used=None):
    """Dimension-eight blocks none of whose coefficients appears in a coupling of models/<model>,
    the coefficients of the block's further flavour structures included: Q_{q^4B}^{(4)} vanishes with
    its own coefficient and has vertices through Y_u Y_u^dag on one current.  used, the coefficients
    that the couplings name (_coefficients), spares reading them again."""
    if used is None:
        used = _coefficients(os.path.join(ROOT, "models", model))
    if used is None:
        return set()
    import re
    return {b for b, e in idx.items() if b.startswith("L8op")
            and not any(re.sub(r"(Re|Im)$", "", w) in used for w in e["wcs"] + e.get("flavour", []))}


def _coefficients(model):
    """The dimension-eight coefficients that the couplings of the model directory `model` name, a complex
    one without its suffix Re or Im, or None when it has no couplings.py."""
    path = os.path.join(model, "couplings.py")
    if not os.path.exists(path):
        # a packed model would otherwise list the operators that have no vertex in it
        if os.path.dirname(os.path.normpath(model)) == os.path.join(ROOT, "models"):
            _unpacked(os.path.basename(os.path.normpath(model)))
        return None
    import re
    return set(re.findall(r"\bc8\w+?(?=Re\b|Im\b|\b)", open(path, errors="replace").read()))


def _check_vertices(vi, idx, model, b, used):
    """Stop unless the vertex lists vi fit the model directory `model`, whose couplings name the
    dimension-eight coefficients used (_coefficients).  Each of them must be a coefficient of
    docs/block_index.json, of an operator whose vertices the lists hold, and those of class 11 must be
    of basis b, the basis the lists are read in.  A model written from another version of
    gen/operators.py, lists older than the model, or a model whose name says one basis while its
    couplings carry the other would otherwise give a selection, and powers of lambda, that are not
    those of the model."""
    import re

    import basis
    where = os.path.relpath(model, ROOT) if model.startswith(ROOT + os.sep) else model
    own = {re.sub(r"(Re|Im)$", "", w): k for k, e in idx.items() for w in e["wcs"] + e.get("flavour", [])}
    unknown = sorted(w for w in used if w not in own)
    if unknown:
        sys.exit(f"{where}: its couplings name coefficients that docs/block_index.json does not hold "
                 f"({', '.join(unknown[:4])}{', ...' if len(unknown) > 4 else ''}), so the model was written from "
                 "another version of gen/operators.py than this tree")
    named = {own[w] for w in used}
    lack = sorted(named - set(vi), key=_bkey)
    if lack:
        sys.exit(f"{where}: build/vertex_index.json has no vertices for {len(lack)} of its operators "
                 f"({', '.join(idx[k]['ops'][0] for k in lack[:4])}{', ...' if len(lack) > 4 else ''}), so the "
                 "vertex lists are older than the model. ./dim8 index writes them again from the vertex cache.")
    other = sorted({basis.of_wcs(idx[k]["wcs"]) for k in named} - {None, b})
    if other:
        sys.exit(f"{where}: its couplings carry the class-11 operators of the {basis.NAME[other[0]]} basis, and "
                 f"its name those of the {basis.NAME[b]} basis, in which the vertex lists would be read "
                 "(gen/basis.py). A model in the Murphy basis carries the suffix _murphy.")


_BVIOL_BLOCKS = None


def _is_bviol(entry):
    """Whether a block violates baryon number, as docs/catalogue.json records it, whatever its number,
    since an operator appended to the encoding comes after the ones that do."""
    global _BVIOL_BLOCKS
    if _BVIOL_BLOCKS is None:
        _BVIOL_BLOCKS = {e["block"] for e in json.load(open(os.path.join(ROOT, "docs", "catalogue.json"))) if e["b_violating"]}
    return entry["block"] in _BVIOL_BLOCKS


def _bkey(b):
    """Sort L8op<n> numerically and anything else (L6cl1, L6cl8a) by name, after them.
    int(b[4:]) alone would raise on L6cl8a, the name of a dimension-six four-fermion
    class, so the names that are not L8op<n> sort by name."""
    return (0, int(b[4:]), "") if b.startswith("L8op") and b[4:].isdigit() else (1, 0, b)


def _write_selection(a, hits, extra, keep6=None, total6=0, which="those listed above"):
    """Write the selection, both groups, as the block list of -o and as the restriction card of
    --card, and return the lines that report it, which ./dim8 select prints after the operators.
    Without --max-power the card is the selection's: the marks and the route search that gives the
    powers enter neither file, and since both are written before that search runs, nothing it does
    can stop them.  With it, _cut_selection passes the part within the cut, after the search.  keep6
    is the set of dimension-six coefficients that --with-dim6 keeps, for a model with a dimension-six
    sector and its entry in build/dim6_index.json, and None keeps them all.  total6, the number of
    dimension-six coefficients of a model with a sector of its own and 0 for any other model, adds a
    line saying how many of them the card keeps."""
    import contextlib
    import io

    lines = []
    if a.out:
        p = os.path.join(ROOT, "build", a.out + ".blocks")
        open(p, "w").write("\n".join(sorted(set(hits) | set(extra), key=_bkey)) + "\n")
        lines.append(f"\nwrote {os.path.relpath(p, ROOT)}  ({len(hits) + len(extra)} entries, both groups)")
    if getattr(a, "card", None):
        # The selection is applied to a released model with no rebuild.  FeynRules has already
        # been run, the model carries all its operators, and the selection is a
        # restriction card that MadGraph applies at import, dropping the zeroed coefficients and
        # every vertex whose couplings then vanish.  Both groups go into the card.  The
        # dimension-six sector is zeroed unless --with-dim6 asks for it, as in the released class
        # cards: a kept coefficient is a placeholder value in the restricted model's defaults, and
        # a dimension-six sector kept by accident would enter NP^2==2 through its square.  With
        # --with-dim6 a model with a dimension-six sector and its entry in build/dim6_index.json
        # keeps exactly the dimension-six coefficients of the selection, those that enter only with
        # a second dimension-six insertion and those of the input relations included, a complex one
        # as its modulus and its phase, and one without that entry keeps its whole dimension-six block.
        # cmd_select has already refused --with-dim6 for a model with no such sector.
        import make_restriction as MR

        model = _model_dir(a.model)
        sels = [b for b in sorted(set(hits) | set(extra), key=_bkey) if b.startswith("L8op")]
        parts6 = []
        if getattr(a, "with_dim6", False):
            if keep6 is None:
                sels.append("dim6")
            else:
                parts6 = sorted(n for n, blk in _model_inputs(model).items()
                                if blk == "DIM6" and _dim6_name(n) in keep6)
                sels += [f"dim6:{n}" for n in parts6]
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            rc = MR.main(["make_restriction", model, a.card] + sels)
        if rc:
            sys.stdout.write(buf.getvalue())
            sys.exit(rc)
        lines += ["", buf.getvalue().rstrip("\n")]
        if total6:
            with6 = getattr(a, "with_dim6", False)
            if with6 and keep6 is not None:
                kept = {_dim6_name(n) for n in parts6}
                lines.append(f"dimension six: the card keeps {len(kept)} of the {total6} coefficients, {which}"
                             + (f" ({len(parts6)} card entries, a complex coefficient being its modulus and its phase)"
                                if len(parts6) != len(kept) else ""))
            elif with6:
                lines.append(f"dimension six: the card keeps all {total6} coefficients, since build/dim6_index.json "
                             "does not list them one by one for this model")
            else:
                lines.append(f"dimension six: the card keeps none of the {total6} coefficients"
                             + (f" (--with-dim6 keeps the {len(keep6)} {which.removeprefix('those ')})" if keep6 is not None
                                else " (--with-dim6 keeps them all)"))
        lines.append(f"import with:  import model {os.path.basename(model)}-{a.card}")
        # MadGraph takes the values of the card as the defaults of the restricted model, and those of the kept
        # coefficients are placeholders, so the report ends with the command that sets a run's values
        lines.append("then set:     examples/studies/set_cards.py <process dir> dim8_all=0"
                     + (" dim6_all=0" if getattr(a, "with_dim6", False) else "")
                     + f" {_first_kept(os.path.join(model, f'restrict_{a.card}.dat'))}=1 Lam=3000"
                     + " ebeam1=6800 ebeam2=6800 hel_recycling=False")
        lines.append("              (after output: every coefficient the card keeps starts at its placeholder value, "
                     "between 0.1 and 0.9)")
    return lines


def _first_kept(card):
    """The first dimension-eight coefficient that the restriction card keeps, by its name, for the example
    of the line that says how to set the values of a run."""
    import re
    block = None
    for line in open(card):
        b = re.match(r"\s*block\s+(\w+)", line, re.I)
        if b:
            block = b.group(1).upper()
            continue
        m = re.match(r"\s*(\d+)\s+([-\deE.+]+)\s*#\s*(\w+)", line)
        if m and block in ("DIM8", "DIM8F") and m.group(3) != "Lam" and float(m.group(2)) != 0.0:
            return m.group(3)
    return "<coefficient>"


def _cut_selection(a, cut, hits, extra, pw, pw6, smp, ir, sel6, extra6, idx6, full6, total6):
    """--max-power: write the part of the selection listed at most cut powers of lambda above the
    Standard Model amplitude of the channel, lambda^smp, as _write_selection writes the whole of it,
    and return the lines that report it.  pw holds the power of each block the listing printed and
    pw6 that of each dimension-six coefficient, "second" for one that enters only with a second
    dimension-six insertion and None for one listed without a power.  A shift of the input relations
    is the Standard Model amplitude times lambda^8 at dimension eight and lambda^4 at dimension six,
    so an operator of the input relations is kept at that power when it is the smaller.  A
    dimension-six class block of a model whose coefficients are listed one by one goes with its
    coefficients, and one of a model with no dimension-six sector, which the listing leaves out,
    stays in the block list as without the cut."""
    import lambda_routes as LR

    top = smp + cut

    def ok(p):
        return isinstance(p, int) and p <= top

    rel8, rel6 = smp + 8, smp + 4
    keep6 = None
    if idx6 is not None:
        keep6 = {w for w in sel6 if pw6.get(w) == "second" or ok(pw6.get(w))}
        keep6 |= {wc for _, wc in extra6 if ok(rel6) or ok(pw6.get(wc)) or pw6.get(wc) == "second"}
    blocks6 = {LR.DIM6_COEFF[w][1] for w in keep6 or () if w in LR.DIM6_COEFF}
    kept = {}
    for b, legs in hits.items():
        if b.startswith("L8op"):
            keep = ok(pw.get(b)) or (b in ir and ok(rel8))
        elif not full6:
            keep = True
        elif idx6 is not None:
            keep = b in blocks6
        else:
            keep = ok(pw.get(b))
        if keep:
            kept[b] = legs
    kept_extra = [b for b in extra if ok(rel8)]
    n8 = sum(1 for b in hits if b.startswith("L8op")) + len(extra)
    k8 = sum(1 for b in kept if b.startswith("L8op")) + len(kept_extra)
    lines = ["", f"cut at {cut} powers of lambda above the Standard Model amplitude, lambda^{top} (--max-power {cut}): "
                 f"{k8} of the {n8} dimension-eight operators listed are kept"]
    if idx6 is not None:
        n6 = len(set(sel6) | {wc for _, wc in extra6})
        unp = sorted(w for w in keep6 if pw6.get(w) == "second")
        lines.append(f"  and {len(keep6)} of the {n6} dimension-six coefficients"
                     + (f", {len(unp)} of them ({', '.join(unp)}) since they enter only with a second dimension-six "
                        "insertion, whose power the counting does not give" if unp else ""))
    elif full6 and getattr(a, "with_dim6", False):
        lines.append("  The dimension-six sector is not cut, since build/dim6_index.json does not list it "
                     "coefficient by coefficient for this model, and --with-dim6 keeps it whole.")
    lines.append("  Left out are those listed at a larger power and those listed without one.")
    return lines + _write_selection(a, kept, kept_extra, keep6=keep6, total6=total6,
                                    which=f"those listed above at lambda^{top} or below")


def cmd_select(a):
    import process as P
    import lambda_routes as LR

    # MadGraph's polarisation marks.  The selection is that of the unpolarised process, but the power
    # of lambda beside each operator is counted in the channel the marks name, as ./dim8 series counts
    # it (gen/lambda_routes.py, channel_slots): a W or Z marked {T} or left unmarked is transverse, and
    # one marked {0} is its Goldstone boson or the gauge boson at one power of lambda.  The Goldstone
    # vertices are those of the Feynman-gauge lists.  Without them, or with lists that are incomplete,
    # the powers are left out with a note rather than counted as transverse, and the selection, the
    # block list and the card are written all the same.
    try:
        marks = P.parse_process(a.process, marks=True)[1]
    except P.ProcessError as e:
        sys.exit(f"{a.process}: {e}")

    # The model the card is for decides the scheme of the second group and which vertices an input
    # scheme has absorbed.  A model that is not one of the released ones is read as the released
    # model of its scheme.
    model = _model_dir(a.model)
    inputs = _model_inputs(model)
    scheme = _scheme(model, inputs)
    ref = _reference_model(model, scheme)
    full6 = any(blk == "DIM6" and k not in DIM6_IN_BASE for k, blk in inputs.items())
    # There is nothing for --with-dim6 to keep in a model without a dimension-six sector of its own: the
    # dimension-six coefficients of its input relations stay at zero, since alone they would be half a
    # calculation.  It stops here, rather than write a card that reads as if dimension six were in.
    if getattr(a, "with_dim6", False) and not full6:
        sys.exit(f"--with-dim6: {os.path.basename(model)} has no dimension-six sector of its own, and the "
                 "dimension-six coefficients of any input relations it has stay at zero, since alone they would "
                 f"be half a calculation. --model {SCHEME_MODEL6.get(scheme, 'dim68_mw')} has the sector"
                 + (", in the same scheme." if scheme in SCHEME_MODEL6 else "."))
    # A model with a dimension-six sector of its own has its dimension-six coefficients listed one by one,
    # from the vertices of each in build/dim6_index.json (validate/dim6_index.py), those that enter at
    # 1/Lambda^4 only with a second dimension-six insertion included (process.select_dim6).
    # Without the index, or without the model's entry in it, the sector is listed by Warsaw class with
    # one insertion, as the class blocks of build/vertex_index.json give it, and a line says so.  total6
    # counts the coefficients of the sector, a complex one once.
    idx6, why6 = _dim6_index(model, scheme) if full6 else (None, None)
    total6 = len({_dim6_name(k) for k, blk in inputs.items() if blk == "DIM6"}) if full6 else 0
    second = set()                           # the blocks that --two-insertions adds
    hits, vi = _select(a.process, collapse=not a.all_flavours, with_bviol=a.with_bviol,
                       two_insertions=getattr(a, 'two_insertions', False), model=ref, second=second,
                       directory=model)
    idx = {b["block"]: b for b in json.load(open(os.path.join(ROOT, "docs/block_index.json")))}
    slots = P.parse_process(a.process, collapse=not a.all_flavours)
    print(f"process : {a.process}")
    print(f"external: {'  '.join('|'.join(s) for s in slots)}   (FeynRules all-incoming convention)")
    print(f"model   : {os.path.relpath(model, ROOT) if model.startswith(ROOT) else model}"
          + (f", {SCHEME_LABEL[scheme]} scheme" if scheme in SCHEME_LABEL else ", no input relations"))
    # DIM8_VDIR may name several cache directories separated by ";", as the writer and the index
    # dumper allow, and base_<hash>.mx is the cached base-model vertex list rather than a block.
    cached = set()
    for _d in VDIR.split(";"):
        _d = _d.strip()
        if os.path.isdir(_d):
            cached |= {f[:-3] for f in os.listdir(_d)
                       if f.endswith(".mx") and not f.startswith(".") and not f.startswith("base_")}
    # dimension-eight operators and dimension-six classes are different units, so they are counted
    # separately.  The dimension-six classes are reported only for a model that has them, under
    # their Warsaw names, the four blocks of psi^4 as one class, and only when build/dim6_index.json
    # does not list the coefficients one by one, which the coefficient listing below does otherwise.
    n8 = sum(1 for b in hits if b.startswith("L8op"))
    n6 = len({LR.DIM6[b][0] for b in hits if b in LR.DIM6}) if full6 else 0
    # The vertex test alone is a LOWER BOUND on the operators that affect the process: an
    # operator that acts through the electroweak input relations shifts gw, g1, the vev and MW
    # in every amplitude whether or not it has a vertex among the external legs.  In
    # p p > w+ w- the muon-decay operators Q_{l^2H^4D}^{(2,4)} carry 46 per cent of the 1/Lambda^4
    # cross section that way in dim8_is (48 in dim8_mw, every coefficient at 1), with no vertex in
    # any diagram.  These operators are
    # part of the answer, listed under their own heading and written into the block list, so the
    # selection is complete at tree level with one insertion.

    # The input relations shift the Standard-Model amplitude, so they enter only where there is one,
    # and only through its electroweak vertices: a process whose tree diagrams are built from quark
    # and gluon vertices alone carries g_s, which is the input alpha_s (g g > g g, u u~ > g g).
    smv = json.load(open(os.path.join(ROOT, "build/sm_vertices.json")))
    sm_tree = P.sm_tree(a.process, smv, collapse=not a.all_flavours)
    sm_ew = sm_tree and P.sm_electroweak(a.process, smv, collapse=not a.all_flavours)
    label = SCHEME_LABEL.get(scheme)
    extra = sorted(_input_scheme_blocks(INPUT_RELATION_WCS) - set(hits), key=_bkey) if sm_ew and label else []
    extra6 = [(op, wc) for op, wc in DIM6_INPUT_RELATION if wc in inputs] if sm_ew and label and full6 else []
    sel6 = P.select_dim6(a.process, idx6, smv, collapse=not a.all_flavours) if idx6 is not None else {}
    if idx6 is not None:
        part6 = f", and {len(sel6)} of the {total6} dimension-six coefficients"
    else:
        part6 = f", and {n6} of the eight dimension-six classes" if n6 else ""
    # For a model with a dimension-six sector the input relations hold dimension-eight operators and
    # dimension-six coefficients, which are different units and are counted apart, the coefficients
    # that the listing holds already left out of the count.
    if not (sm_ew and label):
        part2 = ""
    elif full6:
        k6 = sum(1 for _, wc in extra6 if wc not in sel6)
        part2 = (f", plus {len(extra)} dimension-eight operators"
                 + (f" and {k6} {'more ' if idx6 is not None else ''}dimension-six coefficient{'' if k6 == 1 else 's'}"
                    if k6 else "")
                 + f" that enter through the {label} input relations")
    else:
        part2 = f", plus {len(extra)} that enter through the {label} input relations"
    print(f"selected: {n8} of the 674 dimension-eight operators through a vertex of the process" + part6 + part2)
    # With the dimension-six coefficients one by one the selection holds those that enter with a second
    # dimension-six insertion as well, and the parentheses say so.  Without a Standard Model tree a
    # dimension-six coefficient with a tree of its own still enters at 1/Lambda^4, through the square of
    # the dimension-six amplitude, which NP^2==2 holds.
    if sm_ew and label and idx6 is not None:
        print("          (complete at tree level with one insertion, or two of dimension six: nothing")
        print("           else can change the prediction at 1/Lambda^4.  The dimension-eight second group")
        print("           has no vertex here and shifts the couplings " + ("and the W mass " if scheme == "alpha" else "")
              + "of every electroweak amplitude)")
    elif sm_ew and label:
        print("          (complete at tree level with one insertion: nothing else can change the")
        print("           prediction at 1/Lambda^4; the second group has no vertex here and shifts")
        print("           the couplings " + ("and the W mass " if scheme == "alpha" else "")
              + "of every electroweak amplitude)")
    elif sm_tree and label and idx6 is not None:
        # The input relations do not shift these Standard Model trees, but a coefficient of the input
        # relations still enters at 1/Lambda^4 through the vev in a dimension-six vertex, as C_Hl^(3) and
        # C_ll' do through the vev shift on the chromomagnetic vertex of C_uG in g g > t t~, and it is
        # then listed with the coefficients that enter with a second dimension-six insertion.
        print("          (complete at tree level with one insertion, or two of dimension six.  Every")
        print("           Standard-Model tree diagram of this process is built from quark and gluon")
        print(f"           vertices, whose coupling g_s is the input alpha_s, so the {label} input")
        print("           relations do not shift them and there is no dimension-eight second group.  A")
        print("           dimension-six coefficient of the input relations still enters at 1/Lambda^4")
        print("           through the vev in a dimension-six vertex, and is listed where it does)")
    elif sm_tree and label:
        print("          (complete at tree level with one insertion.  Every Standard-Model tree diagram")
        print("           of this process is built from quark and gluon vertices, whose coupling g_s")
        print(f"           is the input alpha_s, so the {label} input relations do not enter and")
        print("           there is no second group)")
    elif sm_tree:
        print("          (complete at tree level with one insertion.  This model has no input")
        print("           relations, so an operator acts only through its own vertices and there")
        print("           is no second group)")
    elif full6:
        print("          The Standard Model has no tree diagram for this process, so nothing interferes")
        print("          with it at 1/Lambda^4: no dimension-eight operator enters at that order, and a")
        print("          dimension-six coefficient enters only through the square of the dimension-six")
        print("          amplitude (NP^2==2), and so only with a tree of one insertion.  The operators")
        print("          that act only through the input relations shift the Standard-Model amplitude,")
        print("          which is absent, so none of them is listed.")
    else:
        print("          The Standard Model has no tree diagram for this process, so nothing interferes")
        print("          at 1/Lambda^4 (NP^2==2 vanishes) and the leading term is the square, of order")
        print("          1/Lambda^8.  The operators that act only through the input relations shift the")
        print("          Standard-Model amplitude, which is absent, so none of them is listed.")
    if full6 and idx6 is None:
        print(f"dimension six: listed by Warsaw class with one insertion, since {why6}.  python3 validate/dim6_index.py "
              "writes the index with which each coefficient is listed, those that enter only with a second one included.")
    # The selector can only see blocks that are in build/vertex_index.json.  If the cache has
    # grown since the index was written, every count below is an UNDERCOUNT.  The test compares
    # names against the FULL index, not counts against the B-conserving view, because the
    # B-violating blocks in the cache would make a count comparison flag a complete index.
    try:
        full_index = set(json.load(open(os.path.join(ROOT, "build/vertex_index.json"))))
    except Exception:
        full_index = set()
    missing = sorted(cached - full_index, key=_bkey)
    if missing:
        print(f"WARNING: {len(missing)} cached blocks are not in the vertex index ({', '.join(missing[:6])}"
              f"{', ...' if len(missing) > 6 else ''}); the selection is incomplete. Run ./dim8 index to regenerate it.")
    print()
    # Each operator is printed with the vertex of its leading tree and that tree's power of lambda
    # (gen/lambda_routes.py), not with the first vertex that fits: when an operator reaches the
    # process through vertices with different numbers of legs, the powers differ.  A tree through
    # the Yukawa coupling of a light quark or a lepton is not counted, since it is suppressed by
    # the fermion mass, whether at a Standard Model vertex or, at dimension six, in the coefficient
    # of a chain (lambda_routes.dim6_yukawa), and neither is a tree whose light fermion line joins
    # two legs of different chirality, which needs the mass itself.  An operator that reaches the
    # process only that way is printed with the vertex that fits and flagged.  The top Yukawa
    # coupling and the top mass are counted, the mass at one power of lambda, and the routes keep
    # the b quark apart from d and s, since a b line turns into a top line at a W vertex.  The
    # selection itself is flavour and chirality blind, so an operator can also be listed that has
    # no tree once the flavours of the external particles are kept (a b quark, say, which joins
    # only a top quark at a W vertex).  A second search that admits every Yukawa coupling and every
    # mass tells the two cases apart.  An operator that only --two-insertions adds has no tree with
    # one insertion, and is flagged so.
    # The selection keeps every QCD order, while QCD=0 in the process, as for electroweak HHjj,
    # takes every tree with a power of g_s out of the powers, as MadGraph does and as
    # gen/lambda_routes.py counts it: the Standard Model vertices with a gluon, and the vertices of
    # an operator with more gluon legs than it has gluon field strengths.  An operator that reaches
    # the process only that way is flagged so, by a third search with every vertex, and a fourth
    # that also admits the light Yukawa couplings and masses says when it needs those as well.
    # Another QCD order is not counted in the powers, which then keep every tree, and the header
    # says so.  The block list and the card are the selection's and are written first
    # (_write_selection), so that the route search can neither change them nor stop them.  With the
    # dimension-six coefficients one by one, --with-dim6 keeps those of the selection and those of the
    # input relations, and nothing else of the dimension-six sector.  With --max-power the card keeps
    # what the powers allow, so it is written after they are counted (_cut_selection), from the power
    # of each block printed, in pw, and of each dimension-six coefficient, in pw6, measured from that
    # of the Standard Model amplitude, smp.
    keep6 = set(sel6) | {wc for _, wc in extra6} if idx6 is not None else None
    cut = getattr(a, "max_power", None)
    pw, pw6 = {}, {}
    tail = _write_selection(a, hits, extra, keep6=keep6, total6=total6) if cut is None else []
    try:
        cat = {e["block"]: e for e in json.load(open(os.path.join(ROOT, "docs", "catalogue.json")))}
        # an operator of the second group that also has a vertex here is marked where it is listed
        ir = _input_scheme_blocks(INPUT_RELATION_WCS) if label and sm_ew else set()
        # and those of them that enter only with the lepton Yukawas on say so, in either group
        yuk = _input_scheme_blocks(LEPTON_YUKAWA_WCS) if label and sm_ew else set()
        try:
            qcd0 = LR.qcd_zero(a.process)
        except ValueError:                   # a QCD order other than 0, which the powers do not count
            qcd0 = None
        gold, why_not, smp = {}, None, None
        if "0" in marks:
            # a longitudinal W or Z: each block keeps the model's vertices and gains its Goldstone
            # vertices from the Feynman-gauge lists, whose Standard Model vertices give the internal
            # lines.  Without them, or with lists that are incomplete, the powers are left out.
            try:
                fgi, fgbase = P.load_data(ROOT, gauge="feynman")
                smv_ = P.standard_model_vertices(fgbase, goldstones=True)
                gold = {b: [v for v in fgi.get(b, []) if P.GOLDSTONES & set(v)] for b in hits}
            except FileNotFoundError:
                why_not = ("the Feynman-gauge vertex lists build/vertex_index_fg.json and build/sm_vertices_fg.json "
                           "are not in this tree")
            except ValueError as e:
                why_not = f"the Feynman-gauge vertex lists in build/ are incomplete ({e})"
        else:
            smv_ = P.standard_model_vertices(P.load_data(ROOT)[1])
        # a cut needs the powers, of the dimension-six coefficients as well when the card keeps them
        if cut is not None and why_not:
            sys.exit(f"--max-power: a longitudinal W or Z ({{0}}) is counted through its Goldstone boson, and {why_not}, "
                     "so there are no powers of lambda to cut on. Nothing was written. Mark the boson {T}, or leave "
                     "it unmarked, for the transverse count.")
        if cut is not None and sel6 and "0" in marks and getattr(a, "with_dim6", False):
            sys.exit("--max-power: the dimension-six coefficients come from build/dim6_index.json, which is read from "
                     "the unitary-gauge model and holds no Goldstone vertex, so with a longitudinal W or Z ({0}) "
                     "they have no powers of lambda to cut on. Nothing was written. Mark the boson {T}, or leave it "
                     "unmarked, for the transverse count, or leave out --with-dim6.")
        if why_not:
            print("each operator with the vertex through which the selection takes it into the process, the")
            print("powers of lambda left out (see the note at the end):")
        else:
            ng = LR.gluon_strengths(list(idx.values())) if qcd0 else {}
            smq = [v for v in smv_ if "G" not in v] if qcd0 else smv_
            cheap = LR.Cheapest(smq, chains=LR.chains())
            cheap_any = LR.Cheapest(smq, chains=LR.chains(), light_yukawa=True)
            # under QCD=0, the trees with a power of g_s, with the light Yukawa couplings and masses
            # left out as in the powers, and then admitted as well
            cheap_qcd = LR.Cheapest(smv_, chains=LR.chains()) if qcd0 else None
            cheap_qcd_any = LR.Cheapest(smv_, chains=LR.chains(), light_yukawa=True) if qcd0 else None
            rslots = P.parse_process(a.process, collapse=False if a.all_flavours else LR.ROUTE_COLLAPSE)
            alts = LR.channel_slots(rslots, marks)
            every = (LR.channel_assignments(alts) if any(marks)
                     else {e: 0 for e in sorted({tuple(sorted(x)) for x in P._product(rslots)})})
            # the assignments of the external particles that a tree can join (LR.conserving), by the
            # charge, the baryon and lepton numbers and the generation labels, and for a B-violating
            # operator by the charge alone
            assignments = {e: k for e, k in every.items() if LR.conserving(e)}
            assignments_bv = {e: k for e, k in every.items() if LR.conserving(e, baryon_number=False)}

            def lead(b, c=cheap, qcd=qcd0):
                verts = vi[b] + gold.get(b, [])
                if qcd:
                    verts = [v for v in verts if v.count("G") <= ng.get(b, 0)]
                if b.startswith("L8op"):
                    n_h = cat.get(b, {}).get("fields", {}).get("N_H")
                    ext = assignments_bv if _is_bviol({"block": b}) else assignments
                    return None if n_h is None else LR.leading(verts, 8, n_h, ext, c, b)
                return LR.leading(verts, 6, LR.DIM6[b][1], assignments, c, b) if b in LR.DIM6 else None

            def lead6(w, c=cheap, qcd=qcd0):
                # a dimension-six coefficient, through its vertices of order NP=1, with the chains of its
                # operator, the Higgs fields of its class and its gluon field strengths (LR.DIM6_COEFF),
                # the Standard Model vertices it rescales counted at their power and four more
                verts = idx6[w]["one"]
                if qcd:
                    verts = [v for v in verts if v.count("G") <= ng.get(w, 0)]
                return LR.leading(verts, 6, LR.dim6_higgs(w), assignments, c, w, rescaled=idx6[w].get("rescaled", ()))

            # The assignments in which the Standard Model has a tree with the couplings the powers count,
            # where an amplitude of order 1/Lambda^4 interferes with it, for second6.
            with_sm6 = ({e: k for e, k in assignments.items() if cheap.reach(LR.anti(e[0]), e[1:])[0] < LR.INF}
                        if sel6 else {})

            def second6(w):
                # A vertex of order NP=2 of the coefficient (build/dim6_index.json, "two") with neither a
                # fermion nor a gluon leg, through which it has a tree with the couplings the powers count
                # in an assignment where the Standard Model has one, or None.  Such a vertex needs no Dirac
                # chains, which the index does not give for the second coefficient of a product, and no
                # count of gluon field strengths, so the route search can confirm it.
                verts = [v for v in idx6[w].get("two", []) if not any(LR.is_fermion(x) or x == "G" for x in v)]
                got = LR.leading(verts, 6, 0, with_sm6, cheap) if verts and with_sm6 else None
                return None if got is None else got[2]

            # The Standard Model amplitude of the channel, found as the trees of the operators are, so
            # that an unmarked W or Z, which the powers count as transverse, is transverse here too:
            # u u~ > z h is lambda^1, Z_T h, where the unpolarised amplitude is lambda^0, from Z_L h.
            # Under QCD=0 it has no tree when every Standard Model tree carries g_s (u u~ > g g).
            smp = LR.sm_power(alts, cheap)
            transverse = any(m is None and any(x in LR.GOLDSTONE for x in s) for s, m in zip(rslots, marks))
            channel = any(marks) or transverse
            if smp is None:
                smtxt = "the Standard Model has no tree" + (" at QCD=0" if qcd0 else " in this channel" if channel else "")
            else:
                smtxt = (f"the Standard Model amplitude {'of the channel ' if channel else ''}is lambda^{smp}"
                         + (", an unmarked W or Z being counted as transverse ({T})" if transverse else ""))
            if cut is not None and smp is None:
                sys.exit(f"--max-power counts the powers of lambda above the Standard Model amplitude, and {smtxt}, "
                         "so there is nothing to count from. Nothing was written. Without --max-power the card "
                         "keeps the whole selection.")
            print("each operator with the vertex of its leading tree and that tree's power of lambda, where")
            print(f"(Lambda, E, v) ~ (lambda^-3, lambda^-2, lambda^-1) and {smtxt}:")
            if qcd0 is None:
                print("(the powers keep every tree, since of the QCD orders they count QCD=0 alone)")
        byclass = {}
        for b in sorted(hits, key=_bkey):
            if b.startswith("L6cl"):
                # listed coefficient by coefficient below when the index has the model
                if not full6 or idx6 is not None:
                    continue
                # the four blocks of psi^4 are one class, printed with the leading tree of the four
                name = LR.DIM6[b][0]
                got = None if why_not else lead(b)
                pw[b] = got[0] if got else None
                old = next((r for r in byclass.get("dim6", []) if r[0] == name), None)
                if old is None:
                    byclass.setdefault("dim6", []).append([name, f"class {b[4:5]}", hits[b], got, False, False, [b]])
                else:
                    old[6].append(b)
                    if got is not None and (old[3] is None or (got[0], len(got[3])) < (old[3][0], len(old[3][3]))):
                        old[3] = got
                continue
            meta = idx.get(b, {})
            got = None if why_not else lead(b)
            pw[b] = got[0] if got else None
            byclass.setdefault(meta.get("cls", 0), []).append(
                [meta.get("ops", [b])[0], meta.get("wcs", [""])[0], hits[b], got, b in ir,
                 cat.get(b, {}).get("redundant_one_generation", False), [b]])
        for cls in sorted(byclass, key=lambda c: (1, 0) if c == "dim6" else (0, c)):
            print("dimension six, Warsaw classes:" if cls == "dim6" else f"class {cls}:")
            for name, wc, legs, got, also, red, blocks in byclass[cls]:
                # the Murphy basis lists it as redundant for one generation: say so wherever it is listed
                note = "   (redundant for one generation, Murphy basis class 20)" if red else ""
                if also and set(blocks) & yuk:
                    note = f"   ({LEPTON_YUKAWA})" + note
                if why_not:
                    print(f"  {name:34s} {wc:16s} {'':10s} via {' '.join(legs)}"
                          + ("   (and the input relations)" if also else "") + note)
                elif got is None:
                    # each reason completes "this vertex ..." after the input relations
                    if all(b in second for b in blocks):
                        why = "only with a second operator insertion"
                    elif any(lead(b, cheap_any) is not None for b in blocks):
                        why = "only through the Yukawa coupling or the mass of a light quark or a lepton"
                    elif qcd0 and any(lead(b, cheap_qcd, False) is not None for b in blocks):
                        why = "only through a power of g_s, which QCD=0 removes"
                    elif qcd0 and any(lead(b, cheap_qcd_any, False) is not None for b in blocks):
                        why = ("only through a power of g_s, which QCD=0 removes, together with the Yukawa "
                               "coupling or the mass of a light quark or a lepton")
                    else:
                        why = "has no tree once the flavours of the external particles are kept"
                    print(f"  {name:34s} {wc:16s} {'':10s} via {' '.join(legs)}"
                          + (f"   (the input relations, and this vertex {why})" if also else f"   ({why})") + note)
                else:
                    print(f"  {name:34s} {wc:16s} {'lambda^' + str(got[0]):10s} via {' '.join(got[2])}"
                          + ("   (and the input relations)" if also else "") + note)
        # The dimension-six coefficients, by Warsaw class in the order of the basis, each with the vertex
        # of its leading tree and that tree's power of lambda, and flagged as the dimension-eight
        # operators are when it has no tree with the couplings the powers count.  A coefficient that
        # enters only with a second dimension-six insertion, of the same coefficient or of another, has no
        # tree of its own and is flagged so, with the vertex that brings it in.  So is one whose trees
        # with one insertion all need the Yukawa coupling or the mass of a light fermion, when it has a
        # vertex of order NP=2 through which the route search finds a tree with the couplings the powers
        # count (second6): C_HW in p p > w+ w-, whose gauge vertices cancel at 1/Lambda^2 against the
        # rescaling of the W field and enter at 1/Lambda^4 on the triple-gauge vertex of C_W.  With a
        # longitudinal W or Z the powers are left out, since the index is read from the unitary-gauge
        # model and holds no Goldstone vertex.
        if sel6:
            ir6 = {wc for _, wc in extra6}
            bare6 = bool(why_not) or "0" in marks
            groups = {}
            for w in LR.DIM6_COEFF:
                if w in sel6:
                    groups.setdefault(LR.DIM6[LR.DIM6_COEFF[w][1]][0], []).append(w)
            for cname, members in groups.items():
                print(f"dimension six, {cname}:")
                for w in members:
                    e, name, also = sel6[w], LR.DIM6_NAMES[w], w in ir6
                    listed = vi.get(LR.DIM6_COEFF[w][1], [])
                    got = None if bare6 or e["kind"] == "second" else lead6(w)
                    if e["kind"] == "second":
                        why = SECOND6
                    elif bare6 or got is not None:
                        why = None
                    elif lead6(w, cheap_any) is not None:
                        alt = second6(w)
                        if alt is not None:
                            e = {"legs": alt, "kind": "second"}
                            why = SECOND6
                        else:
                            why = "only through the Yukawa coupling or the mass of a light quark or a lepton"
                    elif qcd0 and lead6(w, cheap_qcd, False) is not None:
                        why = "only through a power of g_s, which QCD=0 removes"
                    elif qcd0 and lead6(w, cheap_qcd_any, False) is not None:
                        why = ("only through a power of g_s, which QCD=0 removes, together with the Yukawa "
                               "coupling or the mass of a light quark or a lepton")
                    else:
                        why = "has no tree once the flavours of the external particles are kept"
                    pw6[w] = got[0] if got is not None else "second" if why == SECOND6 else None
                    if got is not None:
                        print(f"  {name:34s} {w:16s} {'lambda^' + str(got[0]):10s} via {' '.join(_as_listed(got[2], listed))}"
                              + ("   (and the input relations)" if also else ""))
                    elif why is None:
                        print(f"  {name:34s} {w:16s} {'':10s} via {' '.join(_as_listed(e['legs'], listed))}"
                              + ("   (and the input relations)" if also else ""))
                    else:
                        print(f"  {name:34s} {w:16s} {'':10s} via {' '.join(_as_listed(e['legs'], listed))}"
                              + (f"   (the input relations, and this vertex {why})" if also else f"   ({why})"))
        # A shift of the input relations multiplies the Standard Model amplitude by v^4/Lambda^4, that
        # is lambda^8, at dimension eight and by v^2/Lambda^2, lambda^4, at dimension six, in a
        # polarisation channel the amplitude of that channel.
        if extra:
            print(f"through the {label} input relations, with no vertex in this process:")
            for b in extra:
                meta = idx.get(b, {})
                print(f"  {meta.get('ops', [b])[0]:34s} {meta.get('wcs', [''])[0]:16s} "
                      f"{'' if smp is None else 'lambda^' + str(smp + 8):10s} class {meta.get('cls', '?')}"
                      + (f"   ({LEPTON_YUKAWA})" if b in yuk else ""))
        if extra6:
            print(f"dimension six, through the {label} input relations (and their own vertices, if any):")
            for op, wc in extra6:
                print(f"  {op:34s} {wc:16s} {'' if smp is None else 'lambda^' + str(smp + 4):10s}")
        if why_not:
            print(f"note: a longitudinal W or Z ({{0}}) is counted through its Goldstone boson, and {why_not}, so "
                  "the powers of lambda are left out. Mark the boson {T}, or leave it unmarked, for the transverse "
                  "count. The selection, and with it the card, does not depend on the marks.")
        elif sel6 and "0" in marks:
            print("note: the dimension-six coefficients come from build/dim6_index.json, which is read from the "
                  "unitary-gauge model and holds no Goldstone vertex, so with a longitudinal W or Z ({0}) their "
                  "powers of lambda are left out. Mark the boson {T}, or leave it unmarked, for the transverse count. "
                  "The selection, and with it the card, does not depend on the marks.")
        if cut is not None:
            tail = _cut_selection(a, cut, hits, extra, pw, pw6, smp, ir, sel6, extra6, idx6, full6, total6)
    finally:
        # the block list and the card were written before the powers were counted
        for line in tail:
            print(line)


def cmd_model(a):
    """Write a FeynRules model holding only the operators the process can see."""
    from emit_fr import emit_model_fragment

    # without --input-scheme the model is written on the plain base, with --input-scheme on the
    # base of the scheme it names ({MW, MZ, GF} unless "alpha"), and the vertices are those of the
    # released model of each, in the basis of DIM8_BASIS (gen/basis.py)
    import basis
    ref = basis.model_name(SCHEME_MODEL[a.input_scheme or "plain"])
    hits, _ = _select(a.process, collapse=not a.all_flavours, with_bviol=a.with_bviol,
                      two_insertions=getattr(a, 'two_insertions', False), model=ref)
    ops = _parse_all()
    # the dimension-six classes the selector also returns live in the base model, not in OPS
    keep = {int(b[4:]) - 1 for b in hits if b.startswith("L8op")}
    sub = [o for i, o in enumerate(ops) if i in keep]
    # a model read on its own has no rules to replace the placeholders of the general flavour form when its
    # UFO is written, so its operators carry the sum of their flavour structures in the Lagrangian itself
    import emit_fr
    txt, index = emit_model_fragment(sub, per_block=1, flavor="mfvexplicit" if emit_fr.FLAVOR == "mfv" else emit_fr.FLAVOR)
    out = os.path.join(ROOT, "models", a.out)
    os.makedirs(out, exist_ok=True)
    open(os.path.join(out, "dim8.fr"), "w").write(
        f"(* dimension-eight operators contributing to:  {a.process}\n"
        f"   {len(sub)} of {len(ops)} operators, each with a vertex in a tree diagram of the process.\n"
        f"   Generated by dim8auto, do not edit. *)\n\n" + txt)
    json.dump(index, open(os.path.join(out, "block_index.json"), "w"), indent=1)
    open(os.path.join(out, "PROCESS"), "w").write(a.process + "\n")
    print(f"{len(sub)} operators -> {os.path.relpath(out, ROOT)}/dim8.fr")


def cmd_ufo(a):
    import basis
    ref = basis.model_name(SCHEME_MODEL[a.input_scheme or "plain"])
    hits, _ = _select(a.process, collapse=not a.all_flavours, with_bviol=a.with_bviol,
                      two_insertions=getattr(a, 'two_insertions', False), model=ref)
    if a.input_scheme:
        extra = _input_scheme_blocks() - set(hits)
        for b in extra:
            hits[b] = ["input scheme"]
        print(f"input scheme: {len(extra)} operator blocks added so the rotation has its partners")
    sel = os.path.join(ROOT, "build", a.out + ".blocks")
    order = lambda b: (0, int(b[4:]), "") if b.startswith("L8op") else (1, 0, b)
    open(sel, "w").write("\n".join(sorted(hits, key=order)) + "\n")
    print(f"{len(hits)} operators selected, writing UFO {a.out}")
    env = _wolfram_env()
    if a.input_scheme:
        env["DIM8_BASE"] = SCHEME_BASE[a.input_scheme]
        env["DIM8_TRUNCATE"] = "1"
    if getattr(a, "two_insertions", False):
        # NP order 2 per dim-8 coupling, so two insertions need the limit at 4 or MadGraph
        # will not generate the diagrams even though the vertices are in the model
        env["DIM8_NPORDER"] = "4"
    if getattr(a, "max_legs", None):
        env["DIM8_MAXLEGS"] = str(a.max_legs)
    subprocess.check_call([WOLFRAM, "-file", os.path.join(ROOT, "validate/fr_writeufo.wls"), a.out, sel], env=env)
    if a.input_scheme:
        # This UFO has no dimension-six sector, so the dimension-six coefficients of its input relations are
        # fixed at zero, as in the released dimension-eight models.  The writer works in tests/gen_smoke.  A
        # UFO the step cannot read, or that the writer did not write, stops the command with its status.
        import freeze_dim6_inputs as F

        return F.main(["freeze_dim6_inputs", os.path.join(ROOT, "tests", "gen_smoke", a.out)])


def _parse_all():
    """The operators in block order, OPS[i] being the operator of L8op{i+1}: the released encoding
    gen/operators.py, which gen/emit_fr.py turns into the Lagrangian the models are built from."""
    from operators import OPS

    return list(OPS)


def cmd_count(a):
    """The lambda power counting of gen/epower.py, without Mathematica."""
    import epower as E

    if a.spec == "all":
        for n in a.n:
            print(f"--- dimension 8, n = {n} legs, regime Lambda >> E >> v ---")
            print(E.table(E.DIM8_CLASSES, n))
            print()
        return 0
    name, args = E.resolve(a.spec)
    lead = []
    for n in a.n:
        t = E.tower(*args, n, target=a.target, HD=E.higgs_with_derivative(name))
        if isinstance(t, str):
            print(f"{name} n={n}: {t}")
            continue
        rows = t if isinstance(t, list) else t.Results
        Dop = E.op_dimension(*args)
        if getattr(a, "verbose", False):
            # the (p, q) that leg counting allows with n legs: p Higgs fields at the vacuum, q powers of the
            # energy, k = p - p_min.  Some of them vanish for every operator of the class (validate/check_legs.py)
            print(f"{name} (D,H,psi,F)={args} n={n}:  p_min={max(args[1]+args[2]+args[3]-n,0)}  "
                  + "  ".join(f"k={r['k']}: (p,q)=({r['p']},{r['q']}) lambda^{3*Dop-2*r['q']-r['p']}" for r in rows))
            continue
        # One number per leg count is what a user needs: the leading power of lambda, with
        # (Lambda, E, v) ~ (lambda^-3, lambda^-2, lambda^-1), so a SMALLER power is a LARGER
        # contribution and lambda^4 is the steepest a dimension-eight operator can be.
        lead.append((n, min(3*Dop - 2*r['q'] - r['p'] for r in rows)))
    if not getattr(a, "verbose", False) and lead:
        legs = {4: "four", 5: "five", 6: "six"}
        print(f"{name:12s} leading power of the class's vertex, by its number of legs: "
              + ", ".join(f"lambda^{l} at {legs.get(n, n)} legs" for n, l in lead))
        print("             (Lambda, E, v) ~ (lambda^-3, lambda^-2, lambda^-1) in the regime Lambda >> E >> v, so at a")
        print("             given number of legs a smaller power is a larger contribution in the tails, lambda^4 at")
        print("             four legs being the fastest growth a dimension-eight operator can have.  The k-th")
        print("             subleading vertex with the same number of legs has k more")
        print("             Higgs fields at the vacuum, trades k powers of E for powers of v and is k powers of")
        print("             lambda higher.  --verbose lists the (p, q) that leg counting allows: p Higgs fields")
        print("             at the vacuum and q powers of the energy (some vanish by C or gauge structure).")
    return 0


def cmd_series(a):
    """The amplitude of a process topology by topology as a series in lambda (gen/lambda_series.py):
    the Standard Model couplings and the dimension-six and dimension-eight classes side by side,
    with MadGraph's {0} and {T} marks counting a longitudinal and a transverse W or Z apart, from the
    vertex lists of the model that --model names (_series_model)."""
    import lambda_series as LS

    return LS.run(a, _series_model)


def _series_model(arg, gauge, proc):
    """The model of ./dim8 series, read as ./dim8 select reads it (cmd_select): the directory that
    --model names, its input scheme, the released model whose vertices it has, in the basis that its
    name or its couplings say, and the vertex lists of that model in the gauge asked for, checked
    against the directory (_model_vertices).  A model without a dimension-six sector of its own has no
    dimension-six term, and the lists lose the blocks of the dimension-six classes, which ./dim8 select
    does not list for it either.  The input relations of its scheme come with it, for the process
    proc: whether the Standard Model has a tree and one with an electroweak vertex, which they shift,
    and, where it does, their operators, as the second group of ./dim8 select holds them, those of
    LEPTON_YUKAWA_WCS apart, and the dimension-six coefficients of DIM6_INPUT_RELATION for a model with
    a dimension-six sector."""
    import basis
    import process as P

    model = _model_dir(arg)
    inputs = _model_inputs(model)
    scheme = _scheme(model, inputs)
    ref = _reference_model(model, scheme)
    full6 = any(blk == "DIM6" and k not in DIM6_IN_BASE for k, blk in inputs.items())
    vi, base = _model_vertices(ref, gauge=gauge, directory=model)
    if not full6:
        vi = {b: v for b, v in vi.items() if not b.startswith("L6cl")}
    smv = json.load(open(os.path.join(ROOT, "build/sm_vertices.json")))
    label = SCHEME_LABEL.get(scheme)
    tree = P.sm_tree(proc, smv)
    rel = {"label": label, "sm_tree": tree, "electroweak": bool(tree and P.sm_electroweak(proc, smv)),
           "w_mass": scheme == "alpha", "dim8": [], "lepton_yukawa": [], "dim6": []}
    if label and rel["electroweak"]:
        yuk = _input_scheme_blocks(LEPTON_YUKAWA_WCS)
        for b in sorted(_input_scheme_blocks(INPUT_RELATION_WCS), key=_bkey):
            rel["lepton_yukawa" if b in yuk else "dim8"].append(b)
        rel["dim6"] = [op for op, wc in DIM6_INPUT_RELATION if wc in inputs] if full6 else []
    b = "murphy" if ref.endswith("_murphy") else "geo"
    return {"path": os.path.relpath(model, ROOT) if model.startswith(ROOT + os.sep) else model, "name": ref,
            "scheme": scheme, "basis": b, "basis_name": basis.NAME[b], "dim6": full6,
            "vertices": vi, "base": base, "input_relations": rel}


def cmd_check(a):
    import check_counts
    import check_symbol_clash
    import cp_parity
    import structural

    rc = 0
    rc |= check_symbol_clash.main(check_symbol_clash.DEFAULT_MODELS)
    print()
    ops = _load_encoding()
    rc |= 1 if structural.report(ops) else 0
    rc |= 1 if cp_parity.report_disagreements(ops) else 0
    print()
    # check_counts.main() ends in sys.exit with its verdict
    try:
        check_counts.main() if hasattr(check_counts, "main") else None
    except SystemExit as e:
        rc |= 1 if e.code else 0
    return rc


def main():
    ap = argparse.ArgumentParser(prog="dim8", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    RELATIONS_UPDATED = ("accept a changed operator that enters the input relations, once its relation has been "
                         "derived again and the base files written again from it (models/src/README.md)")
    rb = sub.add_parser("rebuild", help="gen/operators.py to the released models, every step in one command",
                        description="From gen/operators.py to the released models, in one command.  It runs ./dim8 "
                                    "build (the checks of the encoding, the files written from it, the vertices of "
                                    "the operators that have changed), computes the dimension-six blocks that have "
                                    "changed, runs ./dim8 index, writes each UFO with validate/fr_writeufo.wls on the "
                                    "base of its input scheme, releases it with examples/release_model.sh, which "
                                    "audits it and has MadGraph import it before it replaces the old model, and then "
                                    "rewrites the catalogue and the vertex lists of the selector from the released "
                                    "models.  It stops at the first step that fails, and a block already computed is "
                                    "not computed again, but it takes no cached block without a stamp "
                                    "(validate/cache_source.py backstamp).  It needs Mathematica and FeynRules, a "
                                    "Python with numpy (DIM8_NUMPY_PY names one) and MadGraph (MG5_DIR), and it checks "
                                    "for them first.  Each UFO is written in many small pieces side by side and "
                                    "joined (--shards), since in one piece it takes about eight hours for a "
                                    "dimension-eight model and about nineteen for a combined one.  The "
                                    "dimension-six caches are DIM8_VDIR6 and DIM8_VDIR6_MW, by default beside "
                                    "the dimension-eight cache with the suffixes 6 and 6_mw.  The models are in the "
                                    "default basis, in which every Higgs field of class 11 carries a derivative, and "
                                    "with DIM8_BASIS=murphy in the Murphy basis, under the same names with the suffix "
                                    "_murphy (gen/basis.py).  models/src/README.md describes the steps.")
    rb.add_argument("-j", "--jobs", type=int, default=6, help="workers at a time for the vertices")
    rb.add_argument("-k", "--kernels", type=int, default=2, help="subkernels per worker")
    rb.add_argument("--models", nargs="+", choices=[m[0] for m in REBUILD_MODELS], metavar="NAME",
                    help="the models to write, among " + ", ".join(m[0] for m in REBUILD_MODELS) + " (default: all that "
                         "this tree can write, the combined ones needing tests/gen_smoke/dim6_smeftsim.fr)")
    rb.add_argument("--dry-run", action="store_true",
                    help="run the checks of the encoding and print what would be computed, run and written, and "
                         "write nothing, which needs no Mathematica")
    rb.add_argument("--blocks", metavar="FILE",
                    help="a trial of the chain: compute only the blocks listed in FILE, write each model from them "
                         "alone, as models/<name>_trial, and leave the released models and the vertex lists alone")
    rb.add_argument("--relations-updated", action="store_true", help=RELATIONS_UPDATED)
    rb.add_argument("--shards", type=int, default=120, metavar="N",
                    help="write each UFO in N shards of blocks and one of the base model with the operators of its "
                         "relations, side by side, and join them (hpc/write_shards.sh): three to four hours on a node "
                         "of 64 cores, set by the slowest shard, the same vertices by validate/compare_ufo.py "
                         "(default 120; 0 writes the UFO in one piece)")
    rb.add_argument("--par", type=int, default=os.cpu_count(), metavar="P",
                    help="shards written at a time, one kernel each (default: the number of processors)")
    rb.set_defaults(func=cmd_rebuild)

    b = sub.add_parser("build", help="check the encoding and compute and cache every operator's vertices")
    b.add_argument("-j", "--jobs", type=int, default=6)
    b.add_argument("-k", "--kernels", type=int, default=2)
    b.add_argument("--dry-run", action="store_true",
                   help="run the checks of the encoding and print what would be computed, and write nothing, "
                        "which needs no Mathematica")
    b.add_argument("--source-only", action="store_true",
                   help="run the checks and write tests/gen_smoke/gen.fr, docs/block_index.json and the catalogue "
                        "from gen/operators.py, and compute no vertices, which needs no Mathematica")
    b.add_argument("--relations-updated", action="store_true", help=RELATIONS_UPDATED)
    b.set_defaults(func=cmd_build)

    s = sub.add_parser("status", help="how much of the cache exists, and the Hermiticity verdicts")
    s.set_defaults(func=cmd_status)

    i = sub.add_parser("index", help="export vertex field content for the selector")
    i.set_defaults(func=cmd_index)

    for name, fn, helptext in (("select", cmd_select, "list the operators a process can see"),
                               ("model", cmd_model, "write a FeynRules model for one process"),
                               ("ufo", cmd_ufo, "write a UFO for one process")):
        p = sub.add_parser(name, help=helptext)
        p.add_argument("process", help='MadGraph syntax, e.g. "p p > h j j" or "p p > w+ h, w+ > l+ vl"')
        p.add_argument("-o", "--out", default=None if name == "select" else "proc")
        p.add_argument("--all-flavours", action="store_true",
                       help="do not collapse c to u and s,b to d. It is slower, the selection in the universal "
                            "model is the same, and the powers of lambda keep the b apart in either case")
        p.add_argument("--two-insertions", action="store_true",
                       help="also select operators that need a SECOND dimension-eight vertex. "
                            "That is order 1/Lambda^8, outside a consistent 1/Lambda^4 analysis. "
                            "Use it for dimension-eight-squared as a 1/Lambda^8 proxy or for "
                            "positivity and unitarity studies. The UFO is written with the NP "
                            "coupling order raised to 4 so MadGraph will generate the diagrams.")
        p.add_argument("--input-scheme", nargs="?", const="mw", default=None, choices=sorted(SCHEME_BASE),
                       help="use the corrected input relations of a scheme, {MW, MZ, GF} (mw, the default "
                            "when the option is given alone, base_inputscheme_mw.fr) or {alpha, MZ, GF} "
                            "(alpha, base_inputscheme.fr), always include the operators that enter them, and "
                            "drop the Lambda^-8 remnant vertices. ./dim8 ufo fixes the dimension-six "
                            "coefficients of these relations at zero, as in the released dimension-eight "
                            "models. With ./dim8 model, load a dimension-six Lagrangian alongside before "
                            "setting any of them.")
        p.add_argument("--max-legs", type=int, default=None, metavar="N",
                       help="drop vertices with more than N legs from the UFO (an n-point vertex only enters "
                            "tree amplitudes with at least n external legs). The worker honours it too")
        p.add_argument("--with-bviol", action="store_true",
                       help="include the B-violating classes 18-21 (MadGraph/ALOHA cannot use their 4-fermion vertices)")
        if name == "select":
            p.add_argument("--card", metavar="NAME",
                           help="also write restrict_NAME.dat into the model named by --model, keeping both "
                                "groups, and import it as  import model <model>-NAME.  Nothing is rebuilt: "
                                "FeynRules has already been run, the released model carries every vertex "
                                "of every operator, and MadGraph applies the card at import")
            p.add_argument("--model", default="models/dim8_mw", metavar="DIR",
                           help="the released UFO the card is written into, a path or a name in models/ "
                                "(default models/dim8_mw, the {MW, MZ, GF} scheme)")
            p.add_argument("--with-dim6", action="store_true",
                           help="also keep dimension-six coefficients in the card, in a model with a "
                                "dimension-six sector of its own (dim68_mw, dim68_is). With its entry in "
                                "build/dim6_index.json (python3 validate/dim6_index.py) these are the "
                                "coefficients the selection lists, those that enter only with a second "
                                "dimension-six insertion, of the same coefficient or another, and those of the "
                                "input relations included, and without it every dimension-six coefficient it "
                                "has. A model with no such sector refuses the option, since the dimension-six "
                                "coefficients of its input relations stay at zero. Without the option they are "
                                "zeroed, like in the released class cards, so that NP^2==2 is the "
                                "dimension-eight interference alone")
            p.add_argument("--max-power", type=int, default=None, metavar="N",
                           help="keep in the card and the block list only the operators and dimension-six "
                                "coefficients listed at most N powers of lambda above the Standard Model "
                                "amplitude of the channel, which the listing gives in its header: those whose "
                                "contributions grow fastest with energy relative to it (N=4 is E^4/Lambda^4 "
                                "at four legs, N=2 E^2/Lambda^2). An operator of the input relations, eight "
                                "powers above at dimension eight and four at dimension six, is kept at that "
                                "power when it is the smaller. One listed without a power is left out, since it then "
                                "enters only through the mass of a light fermion, a second insertion, a power "
                                "of g_s that QCD=0 removes, or not at all once the flavours are kept, except a "
                                "dimension-six coefficient that enters only with a second dimension-six "
                                "insertion, which is kept since the counting does not give its power. The "
                                "option stops, writing nothing, where the powers are left out or the "
                                "Standard Model has no tree")
        p.set_defaults(func=fn)

    k = sub.add_parser("count", help="lambda power counting for a class or (D,H,psi,F), or 'all'")
    k.add_argument("spec", help='e.g. "psi^2H^2D^3", "3,2,2,0", or all')
    k.add_argument("-n", nargs="+", type=int, default=[4, 5, 6], help="vertex multiplicities")
    k.add_argument("--target", type=int, default=None, help="only report if this lambda exponent appears")
    k.add_argument("--verbose", action="store_true", help="the (p, q) that leg counting allows with these legs, leading and subleading, instead of the leading power")
    k.set_defaults(func=cmd_count)

    import lambda_series as LS
    r = sub.add_parser("series", help="the amplitude of a process topology by topology as a series in lambda",
                       description=LS.__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    LS.add_arguments(r)
    r.set_defaults(func=cmd_series)

    c = sub.add_parser("check", help="symbolic validation gates")
    c.set_defaults(func=cmd_check)

    a = ap.parse_args()
    # at a terminal, select and series print their terminal view (gen/pretty.py), and in a pipe the plain text
    if a.cmd in ("select", "series") and not getattr(a, "json", False) and not getattr(a, "latex", False):
        import pretty
        if pretty.wanted():
            sys.exit(pretty.run(a.func, a))
    sys.exit(a.func(a) or 0)


if __name__ == "__main__":
    main()
