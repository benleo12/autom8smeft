# Operators whose coefficients enter the electroweak input scheme (the input-scheme section of the paper).
# With --input-scheme their blocks are ALWAYS included: the canonical field rotation cancels
# against the kinetic and mass terms these operators induce, so a model that shifted the
# couplings without carrying the operators would be inconsistent as soon as a coefficient
# is nonzero: without them the writer's truncation test finds an uncancelled Lambda^-4
# {A,A,H} vertex.  Resolved by coefficient name so the list cannot go stale.
INPUT_SCHEME_WCS = ["c8W2H4x1", "c8W2H4x3", "c8B2H4x1", "c8WBH4x1", "c8H6x1", "c8H6x2",
                    "c8l2H4Dx2", "c8l2H4Dx4", "c8l4H2x1", "c8l2e2H2x1", "c8l2e2H2x2",
                    "c8G2H4x1", "c8H8", "c8quH5", "c8qdH5", "c8leH5"]
# The eleven of those that act with NO vertex of their own in a process: they shift gw, g1, the
# vev, the W mass and the neutral field rotation (the paper's expressions for delta v and
# delta M_W), and so enter every electroweak amplitude.  c8l4H2x1 is one of them only through its
# flavour structures: the crossed contraction of its two lepton currents, alone and with one
# lepton Yukawa insertion, holds the (nu_mu mu)(e nu_e) current of muon decay, and so shifts G_F.
# c8l2e2H2x1 and c8l2e2H2x2 are two of them through the crossed structure (Y_e)_pt (Y_e^dag)_sr,
# which gives muon decay the scalar coupling of (ebar P_L nu_e)(nubar_mu P_R mu).  It shifts G_F
# through its interference with the Standard Model, weighted by the electron's Yukawa, and through
# its square, and so only when the lepton Yukawas are on (gen/derive_geo.py).
# The other five of INPUT_SCHEME_WCS shift the gluon normalisation, the Higgs quartic and the
# Yukawas, which are couplings the same operators also produce as vertices of their own (g g h,
# h h h, h f fbar), so wherever that shift matters the vertex test above already lists the operator.
INPUT_RELATION_WCS = ["c8W2H4x1", "c8W2H4x3", "c8B2H4x1", "c8WBH4x1", "c8H6x1", "c8H6x2",
                      "c8l2H4Dx2", "c8l2H4Dx4", "c8l4H2x1", "c8l2e2H2x1", "c8l2e2H2x2"]
# The same eleven enter the relations of both schemes (gen/input_scheme_formulae.json and _mw.json).
# In the {alpha, MZ, GF} scheme they shift the derived W mass, in the {MW, MZ, GF} scheme the derived
# electromagnetic coupling.  dim8_plain has no input relations: it drops the two-point terms of
# these operators, which then act only through their vertices.
# Two of the eleven shift G_F only through the scalar coupling of muon decay, which is proportional to
# y_e y_mu and interferes with the Standard Model in proportion to y_e^2, so only on a card with the
# electron and muon Yukawas on (yme and ymm, which the default card sets to zero).  ./dim8 select keeps
# them in the card of every electroweak process, as it keeps an operator that reaches a process only
# through the Yukawa coupling of a light fermion, and prints LEPTON_YUKAWA beside them.
LEPTON_YUKAWA_WCS = ["c8l2e2H2x1", "c8l2e2H2x2"]
LEPTON_YUKAWA = "enters G_F only with nonzero electron and muon Yukawas"
SCHEME_LABEL = {"alpha": "{alpha, MZ, GF}", "mw": "{MW, MZ, GF}"}
# The dimension-six coefficients of the input relations, for a model with a dimension-six sector.
# C_{ll}' (the flavour entry 1221, which enters muon decay) and C_{Hl}^{(3)} shift G_F, and C_{HD}
# and C_{HWB} shift M_Z and the neutral rotation, so the four enter every electroweak amplitude,
