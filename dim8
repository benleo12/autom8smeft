    rc = _build_vertices(a, index, changed, only)
    if rc:
        return rc
    if not a.dry_run:
        # A Hermiticity failure of an edited operator ends the chain here, before any model holds it, and
        # so does a block whose check was deferred ("nonhermitian -1"), which has not passed it.
        import re
        statuses = (os.path.join(VDIR, b + ".status") for b in blocks)
        bad = [os.path.basename(p)[:-7] for p in statuses if os.path.exists(p)
               and re.search(r"nonhermitian -?[1-9]", open(p, errors="replace").read())]
        if bad:
            sys.exit("stopped: blocks that fail the Hermiticity check of the worker, or that were built with the check "
                     f"deferred (nonhermitian -1, and DIM8_HERMONLY=1 runs it): {' '.join(bad[:30])}")
    # the dimension-six caches of the combined models, and the one the vertex lists read, whichever models are asked for
    schemes = {m[1] for m in models if m[2]}
