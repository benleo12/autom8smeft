# 04: the dimension-eight squared term, 1/Lambda^8 (one insertion in each amplitude, NP<=2 NP^2==4).
# It is positive definite.  The 1/Lambda^8 order also receives contributions from operators above
# dimension eight, which no model here contains, so this term estimates the truncation uncertainty
# and is not the 1/Lambda^8 prediction.  The two operators are those of example 03.
import model dim8_is
generate p p > w+ w- NP<=2 NP^2==4
output runs/04_ww_sq
launch runs/04_ww_sq
set nevents 5000
set hel_recycling False
set ebeam1 6800
set ebeam2 6800
set lam__2 1000
set c8q2WH2Dx1 1.0
set c8q2W2Dx1 1.0
done
