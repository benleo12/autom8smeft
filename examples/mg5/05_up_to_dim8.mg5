# 05: "up to dimension eight" in one run: SM + interference + squared, one insertion per amplitude
# (NP<=2).  For these coefficients the cross section equals 02 + 03 + 04 within statistics.  This
# holds here but not in general.  02 is run with the coefficients OFF, so the identity needs the
# NP=0 bin to be independent of the coefficients.  It is for these two operators: c8q2W2Dx1 and
# c8q2WH2Dx1 leave M_W at 79.82436 and v at 246.22057, their Standard Model values.  An operator
# that acts through the {alpha, MZ, GF} input relations, such as c8H6x1 or c8l2H4Dx2, moves the
# NP=0 bin, so 02 is no longer the right term to add and the identity fails by that shift.  See
# docs/HOW_TO_BREAK_IT.md.
import model dim8_is
generate p p > w+ w- NP<=2
output runs/05_ww_upto8
launch runs/05_ww_upto8
set nevents 5000
set hel_recycling False
set ebeam1 6800
set ebeam2 6800
set lam__2 1000
set c8q2WH2Dx1 1.0
set c8q2W2Dx1 1.0
done
