# 08: one event sample, many coefficient points.  Generate with a reference point, then reweight
# to the points listed in cards/reweight_card.dat (copy it in when MadGraph asks for the reweight
# card, or edit runs/08_ww_rw/Cards/reweight_card.dat before launching).
import model dim8_is
generate p p > w+ w- NP<=2
output runs/08_ww_rw
launch runs/08_ww_rw
reweight=ON
set nevents 10000
set hel_recycling False
set ebeam1 6800
set ebeam2 6800
set lam__2 1000
set c8W2H2D2x1 1.0
done
