    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_W2B2n7" },
  (* SmeftFR class 2 (phi^8): 1 coefficients *)
  cphi8 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 44,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_phi8" },
  (* SmeftFR class 3 (phi^6 D^2): 2 coefficients *)
  cphi6Box == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 45,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_phi6Box" },
  cphi6D2 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 46,
