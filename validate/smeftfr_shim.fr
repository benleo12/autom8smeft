  cG2W2n4 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 26,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_G2W2n4" },
  cG2W2n5 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 27,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_G2W2n5" },
  cG2W2n6 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 28,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_G2W2n6" },
  cG2W2n7 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 29,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_G2W2n7" },
  cG2B2n1 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 30,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_G2B2n1" },
  cG2B2n2 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 31,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_G2B2n2" },
  cG2B2n3 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 32,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_G2B2n3" },
  cG2B2n4 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 33,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_G2B2n4" },
  cG2B2n5 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 34,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_G2B2n5" },
  cG2B2n6 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 35,
