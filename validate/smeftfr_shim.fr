  cW2B2n4 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 40,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_W2B2n4" },
  cW2B2n5 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 41,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_W2B2n5" },
  cW2B2n6 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 42,
