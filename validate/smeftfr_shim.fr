    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_W2phi2D2n3" },
  cW2phi2D2n4 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 72,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_W2phi2D2n4" },
  cW2phi2D2n5 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 73,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_W2phi2D2n5" },
  cW2phi2D2n6 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 74,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_W2phi2D2n6" },
  cWBphi2D2n1 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 75,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_WBphi2D2n1" },
  cWBphi2D2n2 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 76,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_WBphi2D2n2" },
  cWBphi2D2n3 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 77,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_WBphi2D2n3" },
  cWBphi2D2n4 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 78,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_WBphi2D2n4" },
  cWBphi2D2n5 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 79,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_WBphi2D2n5" },
  cWBphi2D2n6 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 80,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_WBphi2D2n6" },
  cB2phi2D2n1 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 81,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_B2phi2D2n1" },
  cB2phi2D2n2 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 82,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_B2phi2D2n2" },
  cB2phi2D2n3 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 83,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_B2phi2D2n3" },
  (* SmeftFR class 8 (X phi^4 D^2): 6 coefficients *)
  cWphi4D2n1 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 84,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_Wphi4D2n1" },
  cWphi4D2n2 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 85,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_Wphi4D2n2" },
  cWphi4D2n3 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 86,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_Wphi4D2n3" },
  cWphi4D2n4 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 87,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_Wphi4D2n4" },
  cBphi4D2n1 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 88,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_Bphi4D2n1" },
  cBphi4D2n2 == { ParameterType -> External, BlockName -> SMEFTFRD8, OrderBlock -> 89,
    Value -> 1, InteractionOrder -> {NP,2}, Description -> "SmeftFR WC for Q_Bphi4D2n2" }
};


(* ---------------------------------------------------------------------------------- *)
(* 6. Pull in the eight SmeftFR bosonic Lagrangian files.                               *)
(*    They contain only SetDelayed definitions of the LQ... blocks, no M$ declarations,  *)
(*    so Get-ing them from inside a model file is safe: LoadModel clears and re-reads    *)
(*    M$Parameters / M$ClassesDescription / M$GaugeGroups around each file it merges     *)
(*    (feynrules Core/ClassDeclarations.m lines 434-448) and these files touch none of   *)
(*    them.  The definitions are delayed, so nothing is evaluated until fr_compare.wls   *)
(*    asks for a block by name, long after the model is fully built.                     *)
(*    Only the bosonic files are loaded.  01..11 are the dim-5/6 and fermionic dim-8     *)
(*    files; they need SmeftFR's own fermion field names and WC tensors and are outside  *)
(*    the scope of this comparison.                                                      *)
(*    Set SMEFTFR$Dir before LoadModel to point somewhere else.                          *)
(* ---------------------------------------------------------------------------------- *)
(* The repository is DIM8_ROOT when that is set, and otherwise the one this file is in: LoadModel
   reads a model file with Get, so $InputFileName is this file's path here. *)
If[!ValueQ[SMEFTFR$Dir],
  SMEFTFR$Dir = FileNameJoin[{
      If[Environment["DIM8_ROOT"] === $Failed, ParentDirectory[DirectoryName[$InputFileName]], Environment["DIM8_ROOT"]],
      "external", "smeftfr_3_03", "lagrangian_dim8_fr_files"}]];

SMEFTFR$BosonicFiles = {"21_X4.fr", "22_phi8.fr", "23_phi6D2.fr", "24_phi4D4.fr",
                        "25_X3phi2.fr", "26_X2phi4.fr", "27_X2phi2D2.fr", "28_Xphi4D2.fr"};

Do[
  Module[{smeftfrpath = FileNameJoin[{SMEFTFR$Dir, smeftfrfile}]},
    If[FileExistsQ[smeftfrpath],
      Get[smeftfrpath],
      (* Abort rather than continue: without these files every LQ... block stays an
         unevaluated symbol, and the comparison would report every pair as differing. *)
      Print["[smeftfr_shim] ABORT, missing SmeftFR file: ", smeftfrpath,
        "\n  it is one of 21_X4.fr to 28_Xphi4D2.fr of lagrangian/ in SmeftFR v3.03 (www.fuw.edu.pl/smeft):",
        " copy them there, or set SMEFTFR$Dir to their directory before LoadModel"];
      Quit[1]]],
  {smeftfrfile, SMEFTFR$BosonicFiles}];

Print["[smeftfr_shim] loaded; SMEFT$WB = ", SMEFT$WB, "; SmeftFR dir = ", SMEFTFR$Dir];
