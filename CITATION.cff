cff-version: 1.2.0
title: autom8smeft
message: >-
  If you use these models, please cite them together with the paper that defines
  the Murphy basis, the papers the default class psi^2H^2D^3 follows, and the tools
  that write and read the models. The authors of the Murphy basis and of those tools
  have no involvement in this work.
type: software
version: "1.0.0"
date-released: "2026-11-11"
authors:
  - family-names: Assi
    given-names: Benoît
    affiliation: "Perimeter Institute for Theoretical Physics, University of Toronto, and Vector Institute"
  - family-names: Martin
    given-names: Adam
    affiliation: "University of Notre Dame"
repository-code: "https://github.com/benleo12/autom8smeft"
license: MIT
keywords:
  - SMEFT
  - dimension eight
  - effective field theory
  - UFO
  - FeynRules
  - MadGraph
references:
  - type: article
    title: "Dimension-8 operators in the Standard Model Effective Field Theory"
    authors:
      - family-names: Murphy
        given-names: Christopher W.
    doi: "10.1007/JHEP10(2020)174"
    identifiers:
      - type: other
        value: "arXiv:2005.00059"
    journal: "JHEP"
    volume: "10"
    year: 2020
    start: 174
    notes: "defines the Murphy basis, on which these models are built"
  - type: article
    title: "Higgs associated production with a vector decaying to two fermions in the geoSMEFT"
    authors:
      - family-names: Corbett
        given-names: Tyler
      - family-names: Martin
        given-names: Adam
    doi: "10.21468/SciPostPhys.16.1.019"
    identifiers:
      - type: other
        value: "arXiv:2306.00053"
    journal: "SciPost Phys."
    volume: "16"
    issue: "1"
    year: 2024
    start: "019"
    notes: "the default models replace the class psi^2H^2D^3 of the Murphy basis by operators in which every Higgs field carries a derivative, following this paper"
  - type: article
    title: "Monolepton production in SMEFT to O(1/Lambda^4) and beyond"
    authors:
      - family-names: Kim
        given-names: Taegyun
      - family-names: Martin
