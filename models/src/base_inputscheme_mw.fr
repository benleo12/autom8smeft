  sw2SM == { ParameterType -> Internal, Value -> 1 - MW^2/MZ^2, Description -> "sin^2 theta_W, exact from the two input masses" },
  gwSM == { ParameterType -> Internal, Value -> 2 MW/vevSM, InteractionOrder -> {QED,1}, Description -> "SM SU(2) coupling from M_W and G_F" },
  g1SM == { ParameterType -> Internal, Value -> gwSM Sqrt[sw2SM/(1 - sw2SM)], InteractionOrder -> {QED,1}, Description -> "SM U(1) coupling" },
  MW2SM == { ParameterType -> Internal, Value -> MW^2, Description -> "M_W^2, an input" },
  aEWSM == { ParameterType -> Internal, Value -> gwSM^2 g1SM^2/(4 Pi (gwSM^2 + g1SM^2)), InteractionOrder -> {QED,2}, Description -> "alpha, derived from the inputs" },
