(* ==================================================================================
   Standard Model base for dim8auto.

   Derived from the working file of Hays, Martin, Setford and Sanz by removing
   everything that is not the Standard Model: the partial dimension-six block (L6, seven
   Warsaw operators) and the hand-typed dimension-eight blocks named L8contact, L8contactZ,
   L8testtest and newL8geo, together with their 43 Wilson coefficients.

   Nothing dimension-six ships here.  A model with one dimension-eight insertion has a
   pure Standard Model remainder, since dim-8 x dim-6 is order 1/Lambda^6, and users who
   want the dimension-six sector should combine with SMEFTsim rather than a partial set
   maintained here.

   Generated by tools/make_sm_base.py; regenerate rather than editing by hand.
   ================================================================================== *)

(***************************************************************************************************************)
(******                       This is the FeynRules mod-file for the Standard model                       ******)
(******                                                                                                   ******)
(******     Authors: N. Christensen, C. Duhr, B. Fuks                                                     ******)
(******                                                                                                   ******)
(****** Choose whether Feynman gauge is desired.                                                          ******)
(****** If set to False, unitary gauge is assumed.                                                          ****)
(****** Feynman gauge is especially useful for CalcHEP/CompHEP where the calculation is 10-100 times faster. ***)
(****** Feynman gauge is not supported in MadGraph and Sherpa.                                              ****)
(***************************************************************************************************************)

(* ************************** *)
(* *****  Information   ***** *)
(* ************************** *)
M$ModelName = "SM_base_for_dim8auto";

(* The Standard Model part of this file descends from the FeynRules SM as distributed with the
   dimension-eight model of Hays, Martin, Setford and Sanz (arXiv:1808.00442).  The dimension-eight
   Lagrangian built on top of it, and everything in dim8auto, is not their work, so their names and
   addresses do not belong in the header of a UFO this repository writes. *)
M$Information = {
  Authors      -> {"dim8auto"},
  Version      -> "1.0.0",
  Date         -> "2026",
  Institutions -> {""},
  Emails       -> {""}
};

FeynmanGauge = False;

(* Covariant derivative sign.  FeynRules builds DC as  del[f,mu] - I FR$DSign g A,  so the
   default FR$DSign = 1 means D = d - i g A.  The basis we implement (Murphy,
   arXiv:2005.00059, Sec. 2) defines D = d + i g1 y B + i g2 t.W + i g3 T.G, so the flag
   MUST be -1.  Without it every covariant derivative in every operator carries the wrong
   sign on its gauge piece relative to the published operator, silently.  SMEFTsim sets
   the same value for the same reason, which is what makes the two interoperable. *)
FR$DSign = -1;

(* ************************** *)
(* ***** NLO Variables ****** *)
(******************************)

FR$LoopSwitches = {{Gf, MW}};
FR$RmDblExt = { ymb -> MB, ymc -> MC, ymdo -> MD, yme -> Me, 
   ymm -> MMU, yms -> MS, ymt -> MT, ymtau -> MTA, ymup -> MU};

