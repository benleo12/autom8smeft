(* ---- Q_{leWH^3}^{(1)} ---- *)
L8op1 := Module[{z8lagH,z8lagN,z8lagS,z8fmgr,z8mu,z8nu,z8rho,z8sig,z8ka,z8la,z8om,z8th,z8mu2,z8nu2,z8rho2,z8sig2,z8i,z8j,z8k,z8l,z8m,z8n,z8o,z8p,z8q,z8r,z8A,z8B,z8C,z8D,z8E,z8F,z8c1,z8c2,z8c3,z8c4,z8c5,z8c6,z8g1,z8g2,z8g3,z8g4,z8g5,z8g6,z8s1,z8s2,z8s3,z8s4,z8s5,z8s6,z8s7,z8s8,z8f1,z8f2,z8f3,z8f4},
  z8fmgr = If[Not[FeynmanGauge], {G0|GP|GPbar -> 0}, {}];
