    c8leWH3x1/Lam^4 ((((-1/2) I) (Ga[z8mu,z8s1,z8s3] Ga[z8nu,z8s3,z8s2] - Ga[z8nu,z8s1,z8s3] Ga[z8mu,z8s3,z8s2]) (LLbar[z8s1,2,z8f1].lR[z8s2,z8f1]) FS[Wi,z8mu,z8nu,3] Phi[2] Phi[2] Phibar[2]) + (((-1/2) I) (Ga[z8mu,z8s1,z8s3] Ga[z8nu,z8s3,z8s2] - Ga[z8nu,z8s1,z8s3] Ga[z8mu,z8s3,z8s2]) (LLbar[z8s1,2,z8f1].lR[z8s2,z8f1]) FS[Wi,z8mu,z8nu,3] Phi[1] Phi[2] Phibar[1]) + ((-1/2) (Ga[z8mu,z8s1,z8s3] Ga[z8nu,z8s3,z8s2] - Ga[z8nu,z8s1,z8s3] Ga[z8mu,z8s3,z8s2]) (LLbar[z8s1,2,z8f1].lR[z8s2,z8f1]) FS[Wi,z8mu,z8nu,2] Phi[1] Phi[2] Phibar[2]) + (((1/2) I) (Ga[z8mu,z8s1,z8s3] Ga[z8nu,z8s3,z8s2] - Ga[z8nu,z8s1,z8s3] Ga[z8mu,z8s3,z8s2]) (LLbar[z8s1,2,z8f1].lR[z8s2,z8f1]) FS[Wi,z8mu,z8nu,1] Phi[1] Phi[2] Phibar[2]) + ((-1/2) (Ga[z8mu,z8s1,z8s3] Ga[z8nu,z8s3,z8s2] - Ga[z8nu,z8s1,z8s3] Ga[z8mu,z8s3,z8s2]) (LLbar[z8s1,2,z8f1].lR[z8s2,z8f1]) FS[Wi,z8mu,z8nu,2] Phi[1] Phi[1] Phibar[1]) + (((1/2) I) (Ga[z8mu,z8s1,z8s3] Ga[z8nu,z8s3,z8s2] - Ga[z8nu,z8s1,z8s3] Ga[z8mu,z8s3,z8s2]) (LLbar[z8s1,2,z8f1].lR[z8s2,z8f1]) FS[Wi,z8mu,z8nu,1] Phi[1] Phi[1] Phibar[1]) + ((1/2) (Ga[z8mu,z8s1,z8s3] Ga[z8nu,z8s3,z8s2] - Ga[z8nu,z8s1,z8s3] Ga[z8mu,z8s3,z8s2]) (LLbar[z8s1,1,z8f1].lR[z8s2,z8f1]) FS[Wi,z8mu,z8nu,2] Phi[2] Phi[2] Phibar[2]) + (((1/2) I) (Ga[z8mu,z8s1,z8s3] Ga[z8nu,z8s3,z8s2] - Ga[z8nu,z8s1,z8s3] Ga[z8mu,z8s3,z8s2]) (LLbar[z8s1,1,z8f1].lR[z8s2,z8f1]) FS[Wi,z8mu,z8nu,1] Phi[2] Phi[2] Phibar[2]) + ((1/2) (Ga[z8mu,z8s1,z8s3] Ga[z8nu,z8s3,z8s2] - Ga[z8nu,z8s1,z8s3] Ga[z8mu,z8s3,z8s2]) (LLbar[z8s1,1,z8f1].lR[z8s2,z8f1]) FS[Wi,z8mu,z8nu,2] Phi[1] Phi[2] Phibar[1]) + (((1/2) I) (Ga[z8mu,z8s1,z8s3] Ga[z8nu,z8s3,z8s2] - Ga[z8nu,z8s1,z8s3] Ga[z8mu,z8s3,z8s2]) (LLbar[z8s1,1,z8f1].lR[z8s2,z8f1]) FS[Wi,z8mu,z8nu,1] Phi[1] Phi[2] Phibar[1]) + (((1/2) I) (Ga[z8mu,z8s1,z8s3] Ga[z8nu,z8s3,z8s2] - Ga[z8nu,z8s1,z8s3] Ga[z8mu,z8s3,z8s2]) (LLbar[z8s1,1,z8f1].lR[z8s2,z8f1]) FS[Wi,z8mu,z8nu,3] Phi[1] Phi[2] Phibar[2]) + (((1/2) I) (Ga[z8mu,z8s1,z8s3] Ga[z8nu,z8s3,z8s2] - Ga[z8nu,z8s1,z8s3] Ga[z8mu,z8s3,z8s2]) (LLbar[z8s1,1,z8f1].lR[z8s2,z8f1]) FS[Wi,z8mu,z8nu,3] Phi[1] Phi[1] Phibar[1])),
    FlavorExpand -> {SU2W, SU2D}] /. z8fmgr;
  z8lagN = OptimizeIndex[z8lagN] /. Eps[args__] :> Signature[{args}] Eps[Sequence @@ Sort[{args}]];
  z8lagN = z8lagN /. del[a_, m1_] del[a_, m2_] Eps[n1__, m1_, n2__, m2_, n3__] :> 0;
  z8lagS = 0;
  Return[z8lagH
    + z8lagN + If[z8lagN === 0, 0, HC[z8lagN]]
