    z8F2[z8f1,z8f2]/Lam^4 ((((-1/2) I) (uRbar[z8s1,z8f1,z8c1].dR[z8s2,z8f2,z8c1]) DC[DC[Phi[2],z8nu],z8mu] DC[Phi[1],z8nu] Ga[z8mu,z8s1,z8s2]) + (((1/2) I) (uRbar[z8s1,z8f1,z8c1].dR[z8s2,z8f2,z8c1]) DC[DC[Phi[1],z8nu],z8mu] DC[Phi[2],z8nu] Ga[z8mu,z8s1,z8s2]) + (((-1/2) I) (uRbar[z8s1,z8f1,z8c1].dR[z8s2,z8f2,z8c1]) DC[DC[Phi[2],z8mu],z8nu] DC[Phi[1],z8nu] Ga[z8mu,z8s1,z8s2]) + (((1/2) I) (uRbar[z8s1,z8f1,z8c1].dR[z8s2,z8f2,z8c1]) DC[DC[Phi[1],z8mu],z8nu] DC[Phi[2],z8nu] Ga[z8mu,z8s1,z8s2])),
    FlavorExpand -> {SU2W, SU2D}] /. z8fmgr;
  z8lagN = OptimizeIndex[z8lagN] /. Eps[args__] :> Signature[{args}] Eps[Sequence @@ Sort[{args}]];
  z8lagN = z8lagN /. del[a_, m1_] del[a_, m2_] Eps[n1__, m1_, n2__, m2_, n3__] :> 0;
  z8lagS = 0;
  Return[z8lagH
    + z8lagN + If[z8lagN === 0, 0, HC[z8lagN]]
    + z8lagS + If[z8lagS === 0, 0, HC[z8lagS]]];
];

(* 749 blocks; the drivers never sum them, they are computed and cached one at a time *)
